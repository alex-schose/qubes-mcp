#!/usr/bin/env python3
"""qmcp.GetPoolStats — AI-scoped disk-budget visibility.

Stage F3; accounting corrected 2026-06-12 (see qmcp_budget.py). AI sees the
total PERSISTENT provisioned footprint of all qubes carrying `ai-managed`
(every qube's `private.size`, plus `root.size` for klasses whose root persists —
TemplateVM / StandaloneVM), plus an operator-set ceiling. Untagged qubes are
neither summed nor enumerated.

Why persistent-only (not every volume's `vol.size`): an AppVM's `root` is a COW
snapshot of its template (real persistent delta ~0) and `volatile` is ephemeral
(gone on shutdown). The original F3 sum counted all three and over-stated real
on-disk usage ~8x (slot-53). Counting only the volumes that persist makes
`used` track reality while staying a provisioned (stable, predictable) number,
and because a volume can't exceed its own size, `used ≤ cap` is a hard ceiling
on real persistent bytes.

Shape decision (unchanged from F3): AI-scoped sum + operator cap. Free-space /
pool-name shapes were rejected as operator-side oracles; the cap is operator-
DEFINED not operator-OBSERVED, so reading it back tells AI only its own budget.

The `used` figure is computed by `qmcp_budget.sum_ai_managed_persistent_bytes`,
imported here so the read surface and the I-0 create-gate share ONE
implementation and cannot drift — the klass-aware persistent rule is too easy to
duplicate wrong. Cap source: `/etc/qmcp/pool-cap` (single integer bytes,
re-read per call, no daemon restart). Inside dom0, qubesadmin talks to qubesd
over the local socket, so the standing `admin.pool.*` / `admin.vm.volume.*`
denies stay in force for any direct AI call; this wrapper is the only path.

Input  (stdin, JSON): {} (no kwargs accepted; empty whitelist).
Output (stdout, JSON):
    {"ok": true,
     "ai_managed_bytes_used": <int>,          -- Σ persistent footprint
     "ai_managed_bytes_cap":  <int>,
     "ai_managed_bytes_headroom": <int>}       -- max(0, cap - used)
    {"ok": false, "error": "pool cap not configured"}   -- opaque on cap read failure
    {"ok": false, "error": "<reason>"}                   -- import / sum failure
"""
from __future__ import annotations

import importlib.util
import json
import os
import sys


def _load_budget_lib():
    """Load the sibling qmcp_budget helper by path — the same sibling-import
    shim the create wrappers use, so the read surface and the gate share one
    `sum_ai_managed_persistent_bytes` (and one `read_cap`) and cannot drift."""
    here = os.path.dirname(os.path.realpath(__file__))
    spec = importlib.util.spec_from_file_location(
        "qmcp_budget", os.path.join(here, "qmcp_budget.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def emit(payload: dict) -> int:
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def main() -> int:
    # Empty kwargs whitelist — read-only surface, no inputs expected. We still
    # drain stdin for callers that send an empty object; any payload is ignored.
    try:
        sys.stdin.read()
    except Exception:
        pass

    try:
        budget = _load_budget_lib()
    except Exception as e:
        return emit({"ok": False, "error": f"budget helper load failed: {e}"})

    cap = budget.read_cap()
    if cap is None:
        return emit({"ok": False, "error": budget.ERR_CAP_MISSING})

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    try:
        used = budget.sum_ai_managed_persistent_bytes(app)
    except Exception as e:
        return emit({"ok": False, "error": f"volume sum failed: {e}"})

    headroom = max(0, cap - used)
    return emit({
        "ok": True,
        "ai_managed_bytes_used": used,
        "ai_managed_bytes_cap":  cap,
        "ai_managed_bytes_headroom": headroom,
    })


if __name__ == "__main__":
    sys.exit(main())
