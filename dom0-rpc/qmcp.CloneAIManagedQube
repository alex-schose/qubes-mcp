    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _load_birth_lib():
    """Load the sibling qmcp_birth helper by path (Wave 2 Stage 2).

    Same sibling-import shim as the helpers above. Returns None on any failure;
    the create path then FAILS CLOSED (see `_birth_stamp`).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_birth", os.path.join(here, "qmcp_birth.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_BIRTH = _load_birth_lib()


def _principal() -> str:
    """The calling principal — the qrexec source domain (D1)."""
    import os
    return os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown"


def _birth_stamp(vm, source_tags) -> None:
    """Wave 2 Stage 2 birth stamp — supersedes I-5's `strip_inherited_tier_tags`.

    `app.clone_vm` copies the SOURCE's tags verbatim (qubesadmin copies all but
    `created-by-*`), which before I-5 let a clone of an `ai-full` source emerge
    `ai-full` — AI minting unbounded full-authority qubes and defeating the
    un-self-escalatability keystone. I-5 answered that by stripping to
    UNTIERED; Stage 2 replaces the blanket strip with the D2 clamp, so the
    clone is born at the source's LITERAL tier bounded by the operator's
    `/etc/qmcp/birth-ceiling`. That is still not escalation — nothing can
    exceed the source, and the source's tier is operator-assigned because AI
    cannot write tags — and it is what makes the clone usable by its creator
    with no operator action in between (the F6 unblock).

    Restrictions on the source (`qmcp-guarded`, `qmcp-egress-locked_*`,
    `anon-vm`) ride along unconditionally: per F-E, a restriction the strip can
    remove is a laundering hole — clone the guarded qube, lose the guard.

    Raises on any mismatch so the caller rolls the clone back rather than ship
    a qube whose authority it could not prove.
    """
    if _BIRTH is None or _TIER is None:
        raise RuntimeError("birth helper unavailable")
    _BIRTH.stamp(
        _BIRTH.TagIO.for_vm(vm),
        source_tags,
        _principal(),
        _TIER.resolve_birth_tier(tags=source_tags),
        _TIER.UMBRELLA,
        _TIER.QMCP_TIER_TAGS,
    )


