admin.vm.CreateInPool.StandaloneVM            *  @tag:ai-managed  @anyvm  deny
admin.vm.CreateInPool.TemplateVM              *  @tag:ai-managed  @anyvm  deny
admin.vm.Create.RemoteVM                      *  @tag:ai-managed  @anyvm  deny
admin.vm.Create.StandaloneVM                  *  @tag:ai-managed  @anyvm  deny
