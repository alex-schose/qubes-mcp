#!/usr/bin/env python3
"""qmcp.DetachDeviceAIManaged — detach a virtual device previously attached
between two ai-managed qubes.

Mirror of qmcp.AttachDeviceAIManaged. Same trust invariant (both backend
and frontend must be ai-managed); same opaque "not found" on missing or
untagged either side.

Input  (stdin, JSON): {
    "device_class": "block" | "usb" | "mic",
    "backend":      "<ai-managed qube exposing the device>",
    "device_id":    "<port_id used at attach time>",
    "frontend":     "<ai-managed qube currently holding the device>",
}

Output (stdout, JSON):
    {"ok": true}
    {"ok": false, "error": "not found"}     -- backend or frontend missing/untagged
    {"ok": false, "error": "<reason>"}

Implementation matches Attach: dom0 tag check via qubesadmin, then
shell out to `qvm-device <class> detach <frontend> <backend>:<port_id>`.
"""
from __future__ import annotations

import json
import shutil
import subprocess
import sys

ALLOWED_CLASSES = {"block", "usb", "mic"}
NOT_FOUND = {"ok": False, "error": "not found"}


_AUDIT_SERVICE = "qmcp.DetachDeviceAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def normalise_mic_port(device_class: str, device_id: str) -> str:
    if device_class == "mic" and not device_id:
        return "mic"
    return device_id


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return emit({"ok": False, "error": f"invalid JSON input: {e}"})

    device_class = req.get("device_class", "")
    backend = req.get("backend", "")
    device_id = req.get("device_id", "")
    frontend = req.get("frontend", "")
    _audit_summary.update({"device_class": device_class, "backend": backend,
                           "frontend": frontend, "device_id": device_id})

    if device_class not in ALLOWED_CLASSES:
        return emit({"ok": False,
                     "error": f"device_class must be one of: {sorted(ALLOWED_CLASSES)}"})

    device_id = normalise_mic_port(device_class, device_id)
    if not device_id:
        return emit({"ok": False, "error": "device_id is required"})
    if not backend or not frontend:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    for name in (backend, frontend):
        if name not in app.domains:
            return emit(NOT_FOUND)
        if "ai-managed" not in app.domains[name].tags:
            return emit(NOT_FOUND)
        # Stage I-5: detach is a CAP_FULL op on BOTH endpoints. Fail-closed;
        # collapses to the same opaque NOT_FOUND (no tier oracle).
        if not _require_full(app.domains[name]):
            return emit(NOT_FOUND)

    if shutil.which("qvm-device") is None:
        return emit({"ok": False, "error": "qvm-device CLI not present in dom0"})

    cmd = ["qvm-device", device_class, "detach", frontend, f"{backend}:{device_id}"]

    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=30)
    except subprocess.TimeoutExpired:
        return emit({"ok": False, "error": "qvm-device detach timed out"})
    except Exception as e:
        return emit({"ok": False, "error": f"qvm-device detach failed to launch: {e}"})

    if proc.returncode != 0:
        # Constant message — raw qvm-device stderr can name an out-of-scope
        # qube or distinguish real device_ids, an existence oracle that would
        # bypass this wrapper's opaque-refusal posture. Detail goes to dom0
        # stderr (operator-only), never to the AI-facing response.
        detail = (proc.stderr.decode(errors="replace").strip()
                  or proc.stdout.decode(errors="replace").strip()
                  or f"qvm-device exit {proc.returncode}")
        print(f"qmcp.DetachDeviceAIManaged: detach failed: {detail}", file=sys.stderr)
        return emit({"ok": False, "error": "detach failed"})

    return emit({"ok": True})


if __name__ == "__main__":
    sys.exit(main())
