#!/usr/bin/env python3
"""qmcp.SetFeatureAIManaged — set a feature on an ai-managed qube.

Stage F1. Wraps admin.vm.feature.Set the same way SetPropertyAIManaged
wraps property.Set: the target must be ai-managed (else the opaque
"not found"), and two classes of feature key get extra handling.

  1. Denied keys (operator-only). `internal` is refused: it hides a
     qube from the operator's app menu / qube manager, which would let
     AI shrink its own visibility to the human. Setting it is the
     operator's call, not AI's. (DENIED_FEATURE_KEYS is the extension
     point for any other security-sensitive key a future stage finds.)

  2. Cross-VM keys. A feature whose value names another qube
     (`audiovm`, `guivm`) must point at an ai-managed qube, mirroring
     SetPropertyAIManaged's cross-ref check on template/netvm/
     default_dispvm — AI must not reach out of its sandbox by pointing
     a cross-VM feature at an operator qube. NOTE: Qubes features are
     a free-form key/value store; `audiovm`/`guivm` are normally VM
     *properties*, not features, so this is defensive validation that
     costs nothing on the happy path and closes the door if those keys
     ever become feature-shaped. The refusal is OPAQUE — missing and
     untagged collapse to one message — so this surface is not an
     existence oracle (cf. the reviewer-ask note: SetPropertyAIManaged
     currently distinguishes "not found" from "not ai-managed" on its
     cross-ref, a latent oracle worth aligning later).

Value coercion: feature values are strings in Qubes. Booleans map to
Qubes convention (True -> "1", False -> "" i.e. unset-equivalent);
ints/strings pass through str(). `null` is rejected — this wrapper
sets, it does not remove (admin.vm.feature.Remove stays denied; removal
is the operator's call).

The response echoes the post-set value read back live from qubesd, so
the MCP side (and the test plan) can confirm the round-trip without a
separate feature-read surface — admin.vm.feature.Get stays denied to AI.

Input  (stdin, JSON): {"name": "<qube>", "feature": "<key>", "value": <value>}
Output (stdout, JSON):
    {"ok": true,  "feature": "<key>", "value": "<readback>"}
    {"ok": false, "error": "not found"}   -- target missing or not ai-managed
    {"ok": false, "error": "<reason>"}    -- denied key, cross-ref, set failure
"""
from __future__ import annotations

import json
import sys

# Operator-only feature keys. AI setting `internal` could hide a qube
# from the operator's menus / manager, undermining human oversight.
DENIED_FEATURE_KEYS = {"internal"}

# Operator-only feature-key PREFIXES. The project's own `qmcp*` namespace is
# reserved so that AI can never seed it.
#
# Today nothing in this codebase reads a feature to make an authorization
# decision — exec is gated by the policy tag (@tag:ai-exec/ai-net/ai-full) plus
# the service file's presence in the template, never by a feature. A clean-room
# rig confirmed that on 2026-08-15, which is why this is *reservation*, not a
# fix for a live escalation. It is here so the general principle holds by
# construction going forward: anything the authorization layer might one day
# read must not be writable by the party being authorized. Claiming the
# namespace now costs nothing; retrofitting it after a future stage starts
# consulting `qmcp-*` would mean auditing every qube for pre-seeded keys.
DENIED_FEATURE_PREFIXES = ("qmcp",)

# Feature keys whose value names another qube; the value must be an
# ai-managed qube. Defensive — see module docstring.
CROSS_REF_FEATURE_KEYS = {"audiovm", "guivm"}

NOT_FOUND = {"ok": False, "error": "not found"}


_AUDIT_SERVICE = "qmcp.SetFeatureAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _load_consent_lib():
    """Load the sibling qmcp_consent helper by path (Stage I-6).

    Same sibling-import shim as qmcp_tier / qmcp_audit. Returns None on any
    failure; the consent gate then FAILS CLOSED at the call site (a None
    helper is treated as verdict "unavailable" => deny), matching the I-5
    tier gate's fail-closed posture, NOT the best-effort audit hook.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_consent", os.path.join(here, "qmcp_consent.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CONSENT = _load_consent_lib()

#: Stage I-6 consent verdict for THIS call, recorded on the audit line only
#: when a gate actually ran. Stays None on the empty-gate default (I-6) and
#: on every ungated path, so emit() OMITS the `consent` key and the audit
#: line is byte-identical to pre-I-6 (INVARIANCE). Set to "approved"/"denied"/
#: "timeout"/"unavailable" by _consent_gate only when the daemon was consulted.
_consent_verdict = None


def _consent_gate(action) -> bool:
    """Stage I-6 operator-consent gate. Returns True to proceed, False to
    refuse. The sibling qmcp_consent helper decides from
    /etc/qmcp/consent-policy whether (service, action) is gated at all.

    Under the I-6 empty gate NOTHING is gated: gate() returns (True, "open")
    without touching the daemon, `_consent_verdict` stays None, and the call
    is byte-neutral. Only when a gate actually runs does the verdict get
    recorded for the audit line. FAIL-CLOSED: a missing/broken helper or any
    exception denies with verdict "unavailable" (same posture as the I-5 tier
    gate, opposite of the best-effort audit hook)."""
    global _consent_verdict
    if _CONSENT is None:
        _consent_verdict = "unavailable"
        return False
    try:
        ok, verdict = _CONSENT.gate(_AUDIT_SERVICE, action, _audit_summary)
    except Exception:
        _consent_verdict = "unavailable"
        return False
    # "open" == gate did not run (empty policy). Leave the verdict unset so
    # the audit line omits the key and stays byte-identical to pre-I-6.
    if verdict != "open":
        _consent_verdict = verdict
    return ok


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    # Stage I-6: pass the consent verdict through; it is None (=> key omitted,
    # byte-identical line) unless a gate actually ran for this call.
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"),
                         consent=_consent_verdict)
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def coerce_value(value) -> str:
    """Coerce a JSON value to the Qubes feature string convention.

    True -> "1", False -> "" (the unset-equivalent falsy value Qubes
    reads as off), everything else -> str(value). `None` is handled by
    the caller (rejected) before reaching here."""
    if isinstance(value, bool):
        return "1" if value else ""
    return str(value)


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        print(f"qmcp.SetFeatureAIManaged: invalid JSON input: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "invalid input"})

    name = req.get("name", "")
    feature = req.get("feature", "")
    value = req.get("value")
    # Whitelist: name + feature KEY only. The feature `value` is never
    # logged (it can carry data the audit log must not retain).
    _audit_summary.update({"name": name, "feature": feature})
    if not name or not feature:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        print(f"qmcp.SetFeatureAIManaged: qubesadmin import failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "feature.Set failed"})

    # Existence-or-tag check — opaque "not found" for missing or untagged,
    # matching qmcp.GetPropertyAIManaged's existence-oracle stance.
    if name not in app.domains:
        return emit(NOT_FOUND)
    vm = app.domains[name]
    if "ai-managed" not in vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: feature-set requires CAP_FULL on the target. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged target (no tier
    # oracle), BEFORE the denied-key / cross-ref checks (authority first).
    if not _require_full(vm):
        return emit(NOT_FOUND)

    # Stage I-6: operator-consent gate — authority, so it fires here (after the
    # tier check, before the denied-key / cross-ref input-validation, matching
    # the I-5 ordering). Inert under the empty policy; once gated, a refusal/
    # timeout/unavailable collapses to the same opaque NOT_FOUND as an
    # untagged/under-tier target (the tag AND tier denials above both emit
    # NOT_FOUND), so it is no consent oracle. Fail-closed (in _consent_gate).
    if not _consent_gate("set-feature"):
        return emit(NOT_FOUND)

    # Denied keys — the target IS ai-managed (AI can see it via
    # ListAIManagedQubes), so an informative refusal leaks nothing about
    # other qubes.
    if feature in DENIED_FEATURE_KEYS:
        return emit({"ok": False, "error": f"feature '{feature}' is operator-only"})

    # Reserved namespace — same informative-refusal reasoning as DENIED_FEATURE_KEYS
    # above: the target is already known to AI via ListAIManagedQubes, so naming
    # the rule leaks nothing about other qubes.
    if feature.startswith(DENIED_FEATURE_PREFIXES):
        reserved = "/".join(f"{p}*" for p in DENIED_FEATURE_PREFIXES)
        return emit({"ok": False, "error":
                     f"feature namespace {reserved} is reserved"})

    # Cross-VM keys — value must name an ai-managed qube. Collapse
    # "missing" and "untagged" to one opaque message so AI cannot probe
    # the existence of untagged qubes through this surface.
    if feature in CROSS_REF_FEATURE_KEYS:
        opaque = {"ok": False,
                  "error": f"cross-VM feature '{feature}' must reference an ai-managed qube"}
        if not isinstance(value, str) or not value:
            return emit(opaque)
        # Short-circuit: don't index app.domains[value] unless value is present.
        if value not in app.domains or "ai-managed" not in app.domains[value].tags:
            return emit(opaque)

    if value is None:
        return emit({"ok": False, "error":
                     "value must be a string, integer, or boolean "
                     "(null/remove is operator-only)"})

    value_str = coerce_value(value)

    try:
        vm.features[feature] = value_str
    except Exception as e:
        # Stage G0e (finding [9]): opaque to AI (raw {e} can name an out-of-scope
        # qube); detail to dom0 stderr.
        print(f"qmcp.SetFeatureAIManaged: feature.Set failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "feature.Set failed"})

    # Live read-back from qubesd (Features.__getitem__ is not cached) so
    # the caller can confirm the round-trip.
    try:
        readback = vm.features.get(feature, None)
    except Exception:
        readback = None

    return emit({"ok": True, "feature": feature, "value": readback})


if __name__ == "__main__":
    sys.exit(main())
