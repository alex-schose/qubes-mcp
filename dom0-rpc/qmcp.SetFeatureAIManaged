#!/usr/bin/env python3
"""qmcp.SetFeatureAIManaged — set a feature on an ai-managed qube.

Stage F1. Wraps admin.vm.feature.Set the same way SetPropertyAIManaged
wraps property.Set: the target must be ai-managed (else the opaque
"not found"), and two classes of feature key get extra handling.

  1. Denied keys (operator-only). `internal` is refused: it hides a
     qube from the operator's app menu / qube manager, which would let
     AI shrink its own visibility to the human. Setting it is the
     operator's call, not AI's. (DENIED_FEATURE_KEYS is the extension
     point for any other security-sensitive key a future stage finds.)

  2. Cross-VM keys. A feature whose value names another qube
     (`audiovm`, `guivm`) must point at an ai-managed qube, mirroring
     SetPropertyAIManaged's cross-ref check on template/netvm/
     default_dispvm — AI must not reach out of its sandbox by pointing
     a cross-VM feature at an operator qube. NOTE: Qubes features are
     a free-form key/value store; `audiovm`/`guivm` are normally VM
     *properties*, not features, so this is defensive validation that
     costs nothing on the happy path and closes the door if those keys
     ever become feature-shaped. The refusal is OPAQUE — missing and
     untagged collapse to one message — so this surface is not an
     existence oracle (cf. the reviewer-ask note: SetPropertyAIManaged
     currently distinguishes "not found" from "not ai-managed" on its
     cross-ref, a latent oracle worth aligning later).

Value coercion: feature values are strings in Qubes. Booleans map to
Qubes convention (True -> "1", False -> "" i.e. unset-equivalent);
ints/strings pass through str(). `null` is rejected — this wrapper
sets, it does not remove (admin.vm.feature.Remove stays denied; removal
is the operator's call).

The response echoes the post-set value read back live from qubesd, so
the MCP side (and the test plan) can confirm the round-trip without a
separate feature-read surface — admin.vm.feature.Get stays denied to AI.

Input  (stdin, JSON): {"name": "<qube>", "feature": "<key>", "value": <value>}
Output (stdout, JSON):
    {"ok": true,  "feature": "<key>", "value": "<readback>"}
    {"ok": false, "error": "not found"}   -- target missing or not ai-managed
    {"ok": false, "error": "<reason>"}    -- denied key, cross-ref, set failure
"""
from __future__ import annotations

import json
import sys

# Operator-only feature keys. AI setting `internal` could hide a qube
# from the operator's menus / manager, undermining human oversight.
DENIED_FEATURE_KEYS = {"internal"}

# Operator-only feature-key PREFIXES. The project's own `qmcp*` namespace is
# reserved so that AI can never seed it.
#
# Today nothing in this codebase reads a feature to make an authorization
# decision — exec is gated by the policy tag (@tag:ai-exec/ai-net/ai-full) plus
# the service file's presence in the template, never by a feature. A clean-room
# rig confirmed that on 2026-08-15, which is why this is *reservation*, not a
# fix for a live escalation. It is here so the general principle holds by
# construction going forward: anything the authorization layer might one day
# read must not be writable by the party being authorized. Claiming the
# namespace now costs nothing; retrofitting it after a future stage starts
# consulting `qmcp-*` would mean auditing every qube for pre-seeded keys.
DENIED_FEATURE_PREFIXES = ("qmcp",)

# Feature keys whose value names another qube; the value must be an
# ai-managed qube. Defensive — see module docstring.
CROSS_REF_FEATURE_KEYS = {"audiovm", "guivm"}

NOT_FOUND = {"ok": False, "error": "not found"}


_AUDIT_SERVICE = "qmcp.SetFeatureAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _load_consent_lib():
    """Load the sibling qmcp_consent helper by path (Stage I-6).

    Same sibling-import shim as qmcp_tier / qmcp_audit. Returns None on any
