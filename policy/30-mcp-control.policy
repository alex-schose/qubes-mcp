# /etc/qubes/policy.d/30-mcp-control.policy -- qubes-mcp
#
# The whole qrexec rulebook for qubes-mcp. It is static: deploy/install.sh
# installs it once, after checking it with qrexec's own parser, and nothing
# writes it at runtime. The installer renders the hub's name into it (default
# `mcp-control`, the only principal in this release).
#
# Two principals appear below.
#   mcp-control      the hub. It is NOT ai-managed. It reaches AI space only
#                    through section B.
#   @tag:ai-managed  AI space: every qube the hub manages or references.
# A few denies also name @anyvm (any source) or @tag:ai-dump (the drop boxes).
# A qube in AI space is MANAGED (ai-managed) or GUARDED (ai-managed plus
# qmcp-guarded). Guarded qubes are listed, read and spawned from, and never
# operated. Gateways are always guarded.
#
# First match wins, across every file in /etc/qubes/policy.d/ in name order.
# Order inside this file: A denies, B the hub, C copies out of AI space, D the
# hub's own operator UX, E the hub's catch-alls. Keep every deny in A above
# the lines it protects.
#
# Never put a comment on the same line as a rule. Write it on its own line.

# =========================================================================
# A. DENIES
# =========================================================================

# A1. Guarded qubes are read and spawned from, never written. The hub cannot
# run, copy or change firewall rules in one (it may still read its firewall),
# and nothing from AI space reaches one at all.
qmcp.RunInAIManaged        *  mcp-control      @tag:qmcp-guarded        deny
qmcp.CopyToAIManaged       *  mcp-control      @tag:qmcp-guarded        deny
admin.vm.firewall.Set      *  mcp-control      @tag:qmcp-guarded        deny
admin.vm.firewall.Reload   *  mcp-control      @tag:qmcp-guarded        deny
qubes.Filecopy             *  mcp-control      @tag:qmcp-guarded        deny
*                          *  @tag:ai-managed  @tag:qmcp-guarded        deny

# A2. Disposables: Qubes' raw @dispvm shortcut is closed for AI space.
# A `@dispvm` rule target matches only the bare keyword. The second line works
# from the template's side: any source, any @dispvm form, any template inside
# AI space, so it still holds for a qube stripped of ai-managed. qmcp's own
# disposables are created inside dom0 and never pass through here.
*                          *  @tag:ai-managed  @dispvm                  deny
*                          *  @anyvm           @dispvm:@tag:ai-managed  deny

# A3. No command execution from AI space into another qube, whatever form the
# target takes, including a named disposable template outside AI space.
qubes.VMShell              *  @tag:ai-managed  @anyvm                   deny
qubes.VMRootShell          *  @tag:ai-managed  @anyvm                   deny
qubes.VMExec               *  @tag:ai-managed  @anyvm                   deny
qubes.VMExecGUI            *  @tag:ai-managed  @anyvm                   deny

# A4. AI space never reaches the hub, by any service. The hub is named here,
# never matched through @anyvm, so this cannot swallow anything else.
*                          *  @tag:ai-managed  mcp-control              deny

# A4b. Only the hub drives qmcp's in-qube services. (Projects add their own
# lines above this in M2.)
qmcp.RunInAIManaged        *  @tag:ai-managed  @anyvm                   deny
qmcp.CopyToAIManaged       *  @tag:ai-managed  @anyvm                   deny

# A5. AI space talks to dom0 only through the services a qube needs to boot and
# report itself. These five allows are Qubes' own defaults for them, owned
# here because the deny after them refuses every other service addressed to
# dom0, including every Admin API call and the policy API. Qubes also
# redirects two services from @default to dom0: qubes.GetDate stays (Qubes'
# own rule already refuses Whonix qubes), qubes.Notifications does not, so no
# AI qube can put a desktop notification in front of the operator.
qubes.Notifications        *  @tag:ai-managed  @anyvm                   deny
qubes.FeaturesRequest      *  @tag:ai-managed  @adminvm                 allow
qubes.NotifyTools          *  @tag:ai-managed  @adminvm                 allow
qubes.NotifyUpdates        *  @tag:ai-managed  @adminvm                 allow
qubes.SyncAppMenus         *  @tag:ai-managed  @adminvm                 allow
qubes.GetRandomizedTime    *  @tag:ai-managed  @adminvm                 allow
*                          *  @tag:ai-managed  @adminvm                 deny

# A6. AI space never calls the Admin API on a qube. Qubes leaves
# these methods to include files that ship empty, so today an AI qube is
# refused only because nothing allows it. These lines make the refusal ours.
# A5 covers calls addressed to dom0; these cover calls addressed to a qube.
# The list is every method qubesd 4.3 registers (qubes/api/admin.py,
# release4.3; device classes pci, block, usb, mic), the two volume Import
# services, and the policy API. @anyvm also matches @default and every
# @dispvm form. tests/test_policy.py checks the list against tests/data/.
admin.backup.Cancel                           *  @tag:ai-managed  @anyvm  deny
admin.backup.Execute                          *  @tag:ai-managed  @anyvm  deny
admin.backup.Info                             *  @tag:ai-managed  @anyvm  deny
admin.deviceclass.List                        *  @tag:ai-managed  @anyvm  deny
admin.Events                                  *  @tag:ai-managed  @anyvm  deny
admin.label.Create                            *  @tag:ai-managed  @anyvm  deny
admin.label.Get                               *  @tag:ai-managed  @anyvm  deny
admin.label.Index                             *  @tag:ai-managed  @anyvm  deny
admin.label.List                              *  @tag:ai-managed  @anyvm  deny
admin.label.Remove                            *  @tag:ai-managed  @anyvm  deny
admin.pool.Add                                *  @tag:ai-managed  @anyvm  deny
admin.pool.Info                               *  @tag:ai-managed  @anyvm  deny
admin.pool.List                               *  @tag:ai-managed  @anyvm  deny
admin.pool.ListDrivers                        *  @tag:ai-managed  @anyvm  deny
admin.pool.Remove                             *  @tag:ai-managed  @anyvm  deny
admin.pool.Set.ephemeral_volatile             *  @tag:ai-managed  @anyvm  deny
admin.pool.Set.revisions_to_keep              *  @tag:ai-managed  @anyvm  deny
admin.pool.UsageDetails                       *  @tag:ai-managed  @anyvm  deny
admin.pool.volume.List                        *  @tag:ai-managed  @anyvm  deny
admin.property.Get                            *  @tag:ai-managed  @anyvm  deny
admin.property.GetAll                         *  @tag:ai-managed  @anyvm  deny
admin.property.GetDefault                     *  @tag:ai-managed  @anyvm  deny
admin.property.Help                           *  @tag:ai-managed  @anyvm  deny
