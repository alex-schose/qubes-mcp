#!/usr/bin/env python3
"""qmcp.SetPropertyAIManaged — write a property on an ai-managed qube.

Cross-reference validation: if the property is one of {template, netvm,
default_dispvm}, the value (a qube name) must itself be ai-managed.
This prevents AI from reaching out of its sandbox by pointing its
qubes' template/netvm/dispvm at the operator's qubes. The cross-ref
refusal is OPAQUE — missing and untagged collapse to one message that
does not echo the referenced value — so this surface is not an
existence oracle (aligned with qmcp.SetFeatureAIManaged's cross-ref).

Egress-qube invariant (Stage C): netvm changes are refused on any
ai-managed qube whose provides_network is true. The intent is that
the operator-designated egress qube (ai-net-router by convention) has
its upstream chosen by the operator in dom0; AI cannot reroute its
own traffic by mutating that pointer. This message stays informative —
it fires only after the target has been confirmed ai-managed, so AI
already has the bit it would learn from it.

Input  (stdin, JSON): {"name": "<qube>", "property": "<prop>", "value": <value>}
Output (stdout, JSON):
    {"ok": true}
    {"ok": false, "error": "not found"}    -- target not ai-managed (indistinguishable from nonexistent)
    {"ok": false, "error": "<reason>"}     -- cross-ref violation (opaque), egress invariant, set failure, etc.
"""
from __future__ import annotations

import json
import sys

CROSS_REF_PROPS = {"template", "netvm", "default_dispvm"}
NOT_FOUND = {"ok": False, "error": "not found"}

#: Stage G0a (review finding [1]): explicit allowlist of the properties an
#: ai-full agent may set. Before G0a this wrapper cross-ref-validated
#: template/netvm/default_dispvm but let EVERY other property fall through to
#: setattr(vm, prop, value) below — so an ai-full agent (and, in the shipped
#: compat default where untiered ai-managed == ai-full, EVERY qube it holds)
#: could set provides_network=True, turn a qube it owns into an egress router,
#: then point siblings' netvm at it (the cross-ref only requires the referent be
#: ai-managed — and it now is). That defeats the Stage-C egress invariant: "the
#: operator chooses ai-net-router's upstream in dom0; that one prefs flip
#: reroutes all AI traffic." The parallel router the agent builds was never the
#: operator's choice. Default-deny closes it: only these properties are settable.
#: provides_network is operator-only (a new egress means the operator builds the
#: router). Everything not listed (autostart, virt_mode, kernel,
#: management_dispvm, default_user, …) is denied until a stage deliberately
#: admits it with its own cross-ref. Volume sizes (private/volatile) are
#: intentionally NOT here: a resize is a vm.volumes[...].resize() op, not a
#: settable VM property, so it could never reach this setattr path — a post-hoc
#: resize surface, if ever wanted, is its own wrapper. The cross-ref members
#: (template/netvm/default_dispvm) stay subject to the CROSS_REF_PROPS check.
SETTABLE_PROPS = {
    "name", "label", "memory", "maxmem", "vcpus",
    "template", "netvm", "default_dispvm",
}

#: Opaque refusal for a property that is not on SETTABLE_PROPS. Deliberately
#: uniform across operator-only (provides_network), not-yet-admitted
#: (autostart/kernel/…), and nonexistent/typo'd names — all collapse to this one
#: message, so the surface is no oracle over WHICH properties the operator
#: reserves (no "operator-only" tell, per the finding-[1] brief). It fires only
#: AFTER the tier + consent authority gates, so — like the cross-ref and egress
#: refusals below, and unlike the pre-authority NOT_FOUND — it is post-authority
#: input-validation feedback on a qube the caller already holds CAP_FULL on; it
#: leaks nothing about qube existence or tier.
PROP_NOT_SETTABLE = {"ok": False, "error": "property not settable"}


_AUDIT_SERVICE = "qmcp.SetPropertyAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _load_consent_lib():
    """Load the sibling qmcp_consent helper by path (Stage I-6).

    Same sibling-import shim as qmcp_tier / qmcp_audit. Returns None on any
    failure; the consent gate then FAILS CLOSED at the call site (a None
    helper is treated as verdict "unavailable" => deny), matching the I-5
    tier gate's fail-closed posture, NOT the best-effort audit hook.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_consent", os.path.join(here, "qmcp_consent.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CONSENT = _load_consent_lib()


def _load_caps_lib():
    """Load the sibling qmcp_caps decision kernel (Wave 2 Stage 1).

    Same sibling-import shim as qmcp_tier / qmcp_consent / qmcp_audit. Returns
    None on any failure — and unlike the tier and consent gates, a None here is
    BENIGN by design: the kernel runs in SHADOW mode, so its absence must change
    nothing at all. If a later stage makes this a gate, the fail-closed posture
    has to move with it (see qmcp_caps' own docstring).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_caps", os.path.join(here, "qmcp_caps.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CAPS = _load_caps_lib()

#: Wave 2 Stage 1 (SHADOW): set ONLY when the decision kernel disagrees with
#: what this wrapper actually did on capability grounds. Stays None whenever
#: they agree — and on every path where the kernel is unavailable or errored —
#: so emit() omits the key and the audit line stays BYTE-IDENTICAL to
#: pre-Stage-1 (INVARIANCE, the I-6 consent pattern). A populated key IS the
#: divergence log that Stage 3's flip to decide() is gated on.
_shadow = None


def _shadow_note(action, roles, params, wrapper_allowed) -> None:
    """Record kernel-vs-wrapper divergence for this call.

    NEVER raises and NEVER changes behaviour: it only sets `_shadow` for the
    audit line. Guarded here AND inside qmcp_caps.shadow_record, the same
    belt-and-suspenders the I-2 audit hook uses at this boundary.

    `roles` maps the kernel's role names ("target"/"source"/"template"/"dvmt"/
    "backend"/"frontend") to qube objects; `wrapper_allowed` is what THIS
    wrapper decided at this point, so the comparison is like-for-like.
    """
    global _shadow
    if _CAPS is None:
        return
    try:
        import os
        _shadow = _CAPS.shadow_record(
            os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown",
            _AUDIT_SERVICE, action, roles, params,
            wrapper_allowed=wrapper_allowed)
    except Exception:
        _shadow = None

#: Stage I-6 consent verdict for THIS call, recorded on the audit line only
#: when a gate actually ran. Stays None on the empty-gate default (I-6) and
#: on every ungated path, so emit() OMITS the `consent` key and the audit
#: line is byte-identical to pre-I-6 (INVARIANCE). Set to "approved"/"denied"/
#: "timeout"/"unavailable" by _consent_gate only when the daemon was consulted.
_consent_verdict = None


def _consent_gate(action) -> bool:
    """Stage I-6 operator-consent gate. Returns True to proceed, False to
    refuse. The sibling qmcp_consent helper decides from
    /etc/qmcp/consent-policy whether (service, action) is gated at all.

    Under the I-6 empty gate NOTHING is gated: gate() returns (True, "open")
    without touching the daemon, `_consent_verdict` stays None, and the call
    is byte-neutral. Only when a gate actually runs does the verdict get
    recorded for the audit line. FAIL-CLOSED: a missing/broken helper or any
    exception denies with verdict "unavailable" (same posture as the I-5 tier
    gate, opposite of the best-effort audit hook)."""
    global _consent_verdict
    if _CONSENT is None:
        _consent_verdict = "unavailable"
        return False
    try:
        ok, verdict = _CONSENT.gate(_AUDIT_SERVICE, action, _audit_summary)
    except Exception:
        _consent_verdict = "unavailable"
        return False
    # "open" == gate did not run (empty policy). Leave the verdict unset so
    # the audit line omits the key and stays byte-identical to pre-I-6.
    if verdict != "open":
        _consent_verdict = verdict
    return ok


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    # Stage I-6: pass the consent verdict through; it is None (=> key omitted,
    # byte-identical line) unless a gate actually ran for this call.
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"),
                         consent=_consent_verdict,
                         # Byte-neutral AND deploy-tolerant: the kwarg is
                         # passed only when there IS a divergence. If dom0
                         # still holds a pre-Stage-1 qmcp_audit.py (a partial
                         # deploy — F9's split-brain family), passing
                         # shadow=None unconditionally would raise TypeError
                         # inside this best-effort guard and silently take the
                         # ENTIRE audit line with it. Omitting it keeps every
                         # agreeing call auditable against the old helper.
                         **({} if _shadow is None
                            else {"shadow": _shadow}))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return emit(NOT_FOUND)

    name = req.get("name", "")
    prop = req.get("property", "")
    value = req.get("value")
    # Whitelist: name + property KEY only. The property `value` is never
    # logged (it can carry data the audit log must not retain).
    _audit_summary.update({"name": name, "property": prop})
    if not name or not prop:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        print(f"qmcp.SetPropertyAIManaged: qubesadmin import failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "set failed"})

    if name not in app.domains:
        return emit(NOT_FOUND)
    vm = app.domains[name]
    if "ai-managed" not in vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: property-set requires CAP_FULL on the target. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged target (no tier
    # oracle), and fires BEFORE the egress / cross-ref checks so an
    # under-tiered qube gets no semantic feedback (authority before
    # input-validation).
    _full_ok = _require_full(vm)
    # Wave 2 Stage 1 (SHADOW): record kernel disagreement only. `property` is
    # passed because the kernel's escalation class keys on it — netvm, template
    # and name are all in SETTABLE_PROPS today and all three are escalation
    # class to the kernel, so these are EXPECTED divergences that Stage 2 flips.
    _shadow_note("set-property", {"target": vm}, {"property": prop}, _full_ok)
    if not _full_ok:
        return emit(NOT_FOUND)

    # Stage I-6: operator-consent gate — authority, so it fires here (after the
    # tier check, before the egress / cross-ref input-validation, matching the
    # I-5 ordering). Inert under the empty policy; once gated, a refusal/
    # timeout/unavailable collapses to the same opaque NOT_FOUND as an
    # untagged/under-tier target (the tag AND tier denials above both emit
    # NOT_FOUND), so it is no consent oracle. Fail-closed (in _consent_gate).
    if not _consent_gate("set-property"):
        return emit(NOT_FOUND)

    # Stage G0a (finding [1]): property allowlist — default-deny. Only
    # SETTABLE_PROPS may be set; provides_network and every other VM property
    # are operator-only. This fires AFTER the tier + consent authority gates (so
    # an under-tiered qube still gets the opaque NOT_FOUND above with no property
    # feedback) and BEFORE the egress / cross-ref input-validation below —
    # authority before input-validation, the same ordering the tier gate uses.
    # The refusal is uniform across operator-only / not-yet-admitted / unknown
    # property names, so it is no oracle over the operator's property policy.
    if prop not in SETTABLE_PROPS:
        return emit(PROP_NOT_SETTABLE)

    # Egress invariant: AI may not retarget the upstream of a network-providing
    # qube. The operator owns that pointer (in dom0) so they can route all AI
    # traffic through Tor, a VPN, or sys-firewall by flipping one prefs line.
    if prop == "netvm":
        try:
            provides_net = bool(getattr(vm, "provides_network", False))
        except Exception:
            provides_net = False
        if provides_net:
            return emit({"ok": False,
                         "error": "netvm of a network-providing qube is operator-only"})

        # F-2/F-3: an egress RETARGET is escalation-class, and refusing it here
        # is what completes Stage 2 rather than what pre-empts Stage 3c.
        #
        # Stage 2 shipped the BIRTH half of §3.4: a create inherits its
        # creator's netvm and a pinned deviation is refused. Measured on
        # hardware 2026-08-18, that guard bought nothing against a deliberate
        # agent while this surface stayed open, by four routes to the same end
        # state. The sharpest needs no netvm argument at all: retarget a source,
        # then CLONE it — §3.4's own "the creation source's netvm outranks the
        # calling principal's" rule then faithfully inherits the egress the
        # agent just chose, and the birth guard has nothing to refuse. The same
        # move through a DispVMTemplate mints disposables on the foreign egress,
        # which is the case §3.4 exists for, because a disposable boots and
        # resolves DNS on first use.
        #
        # So birth-egress enforcement is worth exactly what retarget
        # enforcement is worth. Shipping one without the other was the bug.
        #
        # `netvm = null` stays ALLOWED, mirroring the birth path's carve-out
        # exactly (qmcp.SpawnAIManagedQube: "explicit null stays allowed with no
        # approval: de-escalation cannot leak"). Taking a qube OFF the network
        # reveals nothing and strands nothing; it is the one direction that is
        # safe by construction.
        #
        # Post-authority, like the provides_network refusal above: it fires only
        # after the tier and consent gates, on a qube the caller already holds
        # CAP_FULL on, so an informative message leaks nothing about existence
        # or tier.
        if value is not None:
            return emit({"ok": False,
                         "error": "netvm change is operator-only; "
                                  "null (disconnect) is permitted"})

    # Cross-reference validation: resolve qube-name values to VM objects and
    # refuse if the referenced VM isn't ai-managed. The refusal collapses
    # "missing" and "untagged" to a single opaque message that does not
    # echo the referenced value — same shape as qmcp.SetFeatureAIManaged.
    # Without the collapse this surface is an existence oracle on every
    # untagged qube name in dom0.
    if prop in CROSS_REF_PROPS:
        if value is not None:
            if not isinstance(value, str):
                return emit({"ok": False,
                             "error": f"{prop} value must be a qube name string or null"})
            opaque = {"ok": False,
                      "error": f"cross-ref property '{prop}' must reference an ai-managed qube"}
            if not value:
                return emit(opaque)
            if value not in app.domains or "ai-managed" not in app.domains[value].tags:
                return emit(opaque)
            value = app.domains[value]

    try:
        setattr(vm, prop, value)
    except AttributeError:
        return emit({"ok": False, "error": f"property '{prop}' does not exist"})
    except Exception as e:
        # Stage G0e (finding [9]): opaque to AI (raw {e} can name an out-of-scope
        # qube); detail to dom0 stderr.
        print(f"qmcp.SetPropertyAIManaged: set failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "set failed"})

    return emit({"ok": True})


if __name__ == "__main__":
    sys.exit(main())
