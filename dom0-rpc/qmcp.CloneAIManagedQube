#!/usr/bin/env python3
"""qmcp.CloneAIManagedQube — clone an ai-managed qube into a new ai-managed qube.

Stage D. Mirrors qmcp.SpawnAIManagedQube's atomic-tag-on-create pattern:
clone, force-tag the clone, post-condition check, rollback on failure.

Input  (stdin, JSON): {
    "source":  "<existing ai-managed qube name>",
    "name":    "<new qube name; alphanumeric+dashes, 1-31 chars>",
}

Output (stdout, JSON):
    {"ok": true,  "name": "<new-vm-name>"}
    {"ok": false, "error": "not found"}     -- source missing or not ai-managed
    {"ok": false, "error": "<reason>"}

The source's existence-or-tag is hidden behind the literal "not found"
to match qmcp.GetPropertyAIManaged's existence-oracle stance: AI cannot
use the clone surface to probe whether a named qube exists untagged.

Inheritance: clone copies the source's prefs (template, netvm, memory, …).
Since the source is ai-managed, its netvm is either None or itself
ai-managed (the SetPropertyAIManaged wrapper enforces that on every set),
so the clone's inherited netvm is already inside the sandbox without
needing a separate retarget step.

Atomicity: there is a brief window between qube creation and tag application
during which the new qube exists untagged. If tag application fails for any
reason, the script rolls back by removing the clone before returning an
error. A post-condition check confirms the tag is visible before declaring
success; if the post-check fails, the clone is rolled back too. The window
is visible to concurrent dom0 admin tools but not observable by AI via the
qrexec policy surface.
"""
from __future__ import annotations

import json
import re
import sys

NAME_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,30}$")
NOT_FOUND = {"ok": False, "error": "not found"}


def _load_budget_lib():
    """Load the sibling qmcp_budget helper by path.

    Stage I-0. The helper lives next to this wrapper in /etc/qubes-rpc/
    (production) and in public/dom0-rpc/ (offline-validation). Loading
    via importlib avoids any sys.path or PYTHONPATH dependency.
    """
    import importlib.util
    import os.path
    here = os.path.dirname(os.path.realpath(__file__))
    spec = importlib.util.spec_from_file_location(
        "qmcp_budget", os.path.join(here, "qmcp_budget.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_AUDIT_SERVICE = "qmcp.CloneAIManagedQube"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _tier_tags_to_strip() -> set:
    """The qmcp tier tags a freshly-created qube must NOT carry — every tag in
    the tier vocabulary except the umbrella. Read off qmcp_tier so it tracks
    the taxonomy. _TIER is guaranteed loaded here: we only reach the create
    path after _require_full passed, which denies when _TIER is None."""
    return set(_TIER.QMCP_TIER_TAGS) - {_TIER.UMBRELLA}


def strip_inherited_tier_tags(vm) -> None:
    """Stage I-5 keystone enforcement. `app.clone_vm` copies the SOURCE's tags
    verbatim (qubesadmin copies all but `created-by-*`), so a clone of an
    `ai-full` source INHERITS `ai-full` — which would let AI mint a CAP_FULL
    qube and, post-flip, fan out unbounded full-authority qubes, defeating the
    un-self-escalatability keystone. Remove every elevation/orthogonal tier tag
    so the clone is UNTIERED (= ai-full in compat, ai-ro post-flip — exactly a
    fresh spawn). Raises if any tier tag survives, so the caller rolls the clone
    back rather than ship an escalated qube."""
    for tag in _tier_tags_to_strip():
        if tag in vm.tags:
            vm.tags.discard(tag)
    leftover = _tier_tags_to_strip() & set(vm.tags)
    if leftover:
        raise RuntimeError(f"failed to strip inherited tier tags: {sorted(leftover)}")


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def best_effort_remove(app, name: str) -> bool:
    """Try to remove a qube created by this script. Returns True on success."""
    try:
        vm = app.domains[name]
    except Exception:
        return True  # already gone
    try:
        if vm.is_running():
            vm.kill()
    except Exception:
        pass
    try:
        del app.domains[name]
        return True
    except Exception:
        return False


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return emit({"ok": False, "error": f"invalid JSON input: {e}"})

    source = req.get("source", "")
    name = req.get("name", "")
    _audit_summary.update({"source": source, "name": name})

    if not NAME_RE.match(name):
        return emit({"ok": False, "error":
            "name must be alphanumeric + dashes, 1-31 chars, starting with alphanumeric"})

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    # Source visibility check — collapse "doesn't exist" and "not ai-managed"
    # to the same opaque "not found" so the clone surface cannot be used as
    # an existence oracle for untagged qubes.
    if source not in app.domains:
        return emit(NOT_FOUND)
    src_vm = app.domains[source]
    if "ai-managed" not in src_vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: clone requires CAP_FULL on the SOURCE qube. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged source (no tier
    # oracle).
    if not _require_full(src_vm):
        return emit(NOT_FOUND)

    if name in app.domains:
        return emit({"ok": False, "error": f"qube '{name}' already exists"})

    # ----- I-0 budget gate (persistent-footprint basis, 2026-06-12) -----
    # Refuse if the projected persistent sum would exceed `/etc/qmcp/pool-cap`.
    # A clone COPIES the source's volumes, so its estimate is the source's full
    # PERSISTENT footprint (private always; root too when the source's klass
    # persists root — e.g. cloning a TemplateVM). is_clone=True selects that
    # estimate. Measurement mirrors qmcp.GetPoolStats (shared summer); cap-
    # missing fails closed with the same opaque message.
    try:
        budget = _load_budget_lib()
    except Exception as e:
        return emit({"ok": False, "error": f"budget helper load failed: {e}"})
    cap_err = budget.check_cap_for_create(app, src_vm, is_clone=True)
    if cap_err is not None:
        return emit({"ok": False, "error": cap_err})

    # ----- Step 1: clone the qube -----
    try:
        new_vm = app.clone_vm(src_vm, name)
    except Exception as e:
        return emit({"ok": False, "error": f"clone failed: {e}"})

    # ----- Step 2: apply ai-managed tag + strip inherited tiers (race window) -----
    try:
        new_vm.tags.add("ai-managed")
        if "ai-managed" not in new_vm.tags:
            raise RuntimeError("tag.add returned but tag not visible on refresh")
        # Stage I-5: clone_vm copied the source's tags, so the clone may carry
        # an inherited ai-full/ai-net/ai-exec/ai-dump. Strip them — a created
        # qube is UNTIERED (umbrella only), never elevated. (See helper.)
        strip_inherited_tier_tags(new_vm)
    except Exception as e:
        removed = best_effort_remove(app, name)
        if removed:
            return emit({"ok": False,
                         "error": f"tag application failed (rolled back): {e}"})
        return emit({"ok": False, "error":
            f"tag application failed AND rollback failed: {e}; "
            f"manual cleanup of qube '{name}' required in dom0"})

    return emit({"ok": True, "name": name})


if __name__ == "__main__":
    sys.exit(main())
