#!/usr/bin/env python3
"""qmcp.ListAIManagedQubes — return ai-managed qubes.

Runs in dom0 with full Admin authority but filters output to qubes
carrying the `ai-managed` tag. Anything untagged is invisible.

Input  (stdin):  ignored (no payload).
Output (stdout): {"ok": true, "qubes": [{name, klass, label, template, power_state}, ...]}
                 {"ok": false, "error": "<reason>"}

Scope redaction (Stage I-1, F-3): the `template` field references another
qube, which may itself not be ai-managed (e.g. an ai-managed AppVM built on
the operator's untagged TemplateVM). It is routed through
qmcp_scope.scoped_name, collapsing to "<out-of-scope>" unless the template
is itself ai-managed, so the list cannot be used to enumerate operator
template names. `name` is always the (ai-managed) qube itself and `label`
is a colour, so neither is redacted.
"""
from __future__ import annotations

import json
import sys


def _load_scope_lib():
    """Load the sibling qmcp_scope helper by path (see qmcp_scope.py /
    Stage I-1). importlib avoids any sys.path or PYTHONPATH dependency,
    so the same code runs in /etc/qubes-rpc/ and in offline-validation."""
    import importlib.util
    import os.path
    here = os.path.dirname(os.path.realpath(__file__))
    spec = importlib.util.spec_from_file_location(
        "qmcp_scope", os.path.join(here, "qmcp_scope.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main() -> int:
    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
        scope = _load_scope_lib()  # fail-closed: a load error aborts the
                                   # whole list rather than emit a raw name
        out = []
        for vm in app.domains:
            if "ai-managed" not in vm.tags:
                continue
            try:
                state = vm.get_power_state()
            except Exception:
                state = "unknown"
            template = getattr(vm, "template", None)
            out.append({
                "name": vm.name,
                "klass": vm.klass,
                "label": vm.label.name if vm.label else None,
                "template": scope.scoped_name(app, template),
                "power_state": state,
            })
        print(json.dumps({"ok": True, "qubes": out}))
        return 0
    except Exception as e:
        # Stage G0e (finding [9]): opaque to AI (the loop reads per-qube props; a
        # qubesd error could name an out-of-scope qube); detail to dom0 stderr.
        import sys
        print(f"qmcp.ListAIManagedQubes: list failed: {e}", file=sys.stderr)
        print(json.dumps({"ok": False, "error": "list failed"}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
