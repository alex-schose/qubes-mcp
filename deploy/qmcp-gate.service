# /etc/systemd/system/qmcp-gate.service -- qubes-mcp
#
# The timer's 15-second pass, which does two things, in this order:
#
#   1. `qmcp seal --expired` closes a guarded qube's open window that has run
#      out, one whose record under /run does not read, and one on a qube
#      `qmcp open` refuses. It goes first because it only ever takes authority
#      away, and because the gate below may stop qubes and take longer.
#   2. `qmcp gate` first holds for the operator's review every qube wearing
#      ai-managed, ai-dump or a qmcp- badge whose qmcp-id label is missing or
#      not its own UUID (it came back from a backup or a copy), then judges
#      every anonymous project, and the hub in anonymous mode, and stops one
#      that is not sound.
#
# qmcp-gate.timer starts this every 15 seconds, and once soon after boot. Each
# command takes the gate's lock in turn and releases it, so they never hold it
# together, and a `qmcp` command the operator runs meanwhile waits for one of
# them rather than racing it.
#
# deploy/install.sh renders a dom0 user in `qubes` into User=: --gate-user if
# given, else the one who ran it with sudo, else the qubes group's only member;
# normally the user the qmcp.* services run as. So the gate needs no root, and
# its desktop notification reaches the operator: a root process cannot reach
# the session's bus (measured on Qubes 4.3.1).

[Unit]
Description=qubes-mcp anonymity gate: judge the anonymous projects, stop one that is not
After=qubesd.service
Wants=qubesd.service

[Service]
Type=oneshot
User=@GATE_USER@
# Both run, in order, and both of their statuses are judged by
# SuccessExitStatus below: a seal that could not judge a window (3) must not
# stop the gate from running.
ExecStart=/usr/local/bin/qmcp seal --expired
ExecStart=/usr/local/bin/qmcp gate
# Only the timer's runs leave the heartbeat `qmcp check` requires recent: a
# check or a window refresh runs the gate too, and must not hide a dead timer.
# `qmcp seal` does not touch it; `qmcp check` sees a window left open by its
# own open-windows item instead.
Environment=QMCP_GATE_HEARTBEAT=1
# 1: a project is not anonymous (the gate stopped it, on this run or an
# earlier one); 3: a
# project could not be judged, or the run could not (the gate's lock held, the
# records unreadable), or a window could not be judged: `qmcp check` reports
# each, and the next run tries again. `qmcp seal --expired` never returns 1.
SuccessExitStatus=1 3
# A run takes well under a second; one that hangs would hold the gate's lock
# and keep every later run out. `qmcp check` fails when no run completes.
TimeoutStartSec=60
NoNewPrivileges=yes
