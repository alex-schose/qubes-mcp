def _principal() -> str:
    """The calling principal — the qrexec source domain (D1)."""
    import os
    return os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown"


def _birth_stamp_direct(app, vm_name: str, source_tags) -> None:
    """Wave 2 Stage 2 birth stamp — supersedes I-5's strip on this path.

    `admin.vm.CreateDisposable` INHERITS the DVMT's tags (slot-16 confirmed the
    umbrella is inherited), so a disposable off an `ai-full` DVMT emerged
    `ai-full` — an ephemeral CAP_FULL grant the gate was meant to withhold.
    I-5 answered with a blanket strip to UNTIERED; Stage 2 replaces it with the
    D2 clamp (source tier, bounded by `/etc/qmcp/birth-ceiling`) so the
    disposable is usable by its creator without an operator action, while
    still never exceeding its DVMT.

    Uses the direct-qubesd TagIO for the same VMCollection-cache-lag reason the
    rest of this wrapper does: `app.domains[disp_name]` raises KeyError for
    several seconds after CreateDisposable (reviewer ask #7).

    Raises on any mismatch so the caller kills the disposable.
    """
    if _BIRTH is None or _TIER is None:
        raise RuntimeError("birth helper unavailable")
    _BIRTH.stamp(
        _BIRTH.TagIO.for_qubesd(app, vm_name),
        source_tags,
        _principal(),
        _TIER.resolve_birth_tier(tags=source_tags),
        _TIER.UMBRELLA,
        _TIER.QMCP_TIER_TAGS,
    )


def netvm_name_direct(app, vm_name: str):
    """A disposable's netvm as a plain name, or None — via direct admin call.

    `admin.vm.property.Get` answers `default=False type=vm <name>`; an unset
    netvm answers with an empty value. Parsed here rather than through
    `app.domains[...]` for the cache-lag reason above.
    """
    raw = app.qubesd_call(vm_name, "admin.vm.property.Get", "netvm")
    text = raw.decode(errors="replace")
    value = text.split(" ", 2)[-1] if " " in text else text
    value = value.strip()
    return value or None


def set_netvm_direct(app, vm_name: str, netvm) -> None:
    """Set a disposable's netvm via direct admin call ("" clears it)."""
    app.qubesd_call(vm_name, "admin.vm.property.Set", "netvm",
                    ("" if netvm is None else str(netvm)).encode())


def kill_direct(app, vm_name: str) -> None:
    """Kill a VM via direct admin call. auto_cleanup=True disposables
    are removed by qubesd once halted, so kill alone suffices."""
    app.qubesd_call(vm_name, "admin.vm.Kill")


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return emit({"ok": False, "error": f"invalid JSON input: {e}"})

    template = req.get("template", "")
    _audit_summary.update({"template": template})
    if not template:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        _audit_summary["error_class"] = type(e).__name__
        return emit({"ok": False, "error": "qubesadmin unavailable"})

    # Template visibility check — collapse missing/untagged to opaque "not found"
    # so the disposable-spawn surface cannot be used as an existence oracle.
    if template not in app.domains:
        return emit(NOT_FOUND)
    tpl = app.domains[template]
    if "ai-managed" not in tpl.tags:
        return emit(NOT_FOUND)

    # Stage I-5: the DVMT must grant CAP_FULL to be a disposable source.
    # Fail-closed; collapses to the same opaque NOT_FOUND as an untagged
    # template (no tier oracle), before the template_for_dispvms cross-ref.
    _full_ok = _require_full(tpl)
    # Wave 2 Stage 1 (SHADOW): record kernel disagreement only. The kernel's role
    # for this surface is "dvmt", matching what this wrapper gates.
    if not _gate("spawn-disposable", {"dvmt": tpl}, {}, _full_ok):
        return emit(NOT_FOUND)

    # Stage I-6: operator-consent gate on the disposable spawn — authority, so
    # it fires here (after the DVMT CAP_FULL check, before the
    # template_for_dispvms / budget input-validation and the privileged
    # CreateDisposable, matching the I-5 ordering). Inert under the empty
    # policy; once gated, a refusal/timeout/unavailable collapses to the same
    # opaque NOT_FOUND as an untagged/under-tier DVMT (the tag AND tier denials
    # above both emit NOT_FOUND), so it is no consent oracle. Fail-closed
    # (in _consent_gate).
    if not _consent_gate("spawn-disposable"):
        return emit(NOT_FOUND)

    # Cross-ref: a DVMT must have template_for_dispvms=True. This is NOT
    # hidden behind "not found" — the template is ai-managed (AI can see
    # it via ListAIManagedQubes), so a more informative error is fine and
    # matches the Stage D klass=DispVM cross-ref behaviour in
    # SpawnAIManagedQube.
    try:
        is_dvmt = bool(getattr(tpl, "template_for_dispvms", False))
    except Exception:
        is_dvmt = False
    if not is_dvmt:
        return emit({"ok": False, "error":
            f"template '{template}' must have template_for_dispvms=True "
            f"to be a DispVM source (klass is {tpl.klass})"})

    # ----- I-0 budget gate (persistent-footprint basis, 2026-06-12) -----
    # Refuse if the projected persistent sum would exceed `/etc/qmcp/pool-cap`.
    # A disposable's root is COW from the DVMT and its volatile is ephemeral, so
    # the only persistent bytes it adds (while it exists) are its private — which
    # it provisions FROM the DVMT. So the estimate uses the DVMT's ACTUAL private
    # (dvmt_private_bytes), not the 2 GiB default: an inflated DVMT yields an
    # inflated disposable. Measurement mirrors qmcp.GetPoolStats (shared summer);
    # cap-missing fails closed with the same opaque message.
    try:
        budget = _load_budget_lib()
    except Exception as e:
        _audit_summary["error_class"] = type(e).__name__
        return emit({"ok": False, "error": "budget helper unavailable"})
    # Serialize the gate->create critical section (see qmcp_budget.acquire_create_lock);
    # held until this one-shot process exits. Best-effort.
    _budget_lock_fd = budget.acquire_create_lock()
    cap_err = budget.check_cap_for_create(
        app, tpl, requested_private=budget.dvmt_private_bytes(tpl))
    if cap_err is not None:
        return emit({"ok": False, "error": cap_err})

    # ----- Wave 2 Stage 2: birth egress (§3.4) -----
    # Per F-F the platform gives the disposable the DVMT's netvm. That is row 1
    # of the inheritance chain by construction, but it is the platform's
    # behaviour rather than our guarantee, so the chain is resolved here and
    # verified after create — BEFORE the disposable is ever started. A DVMT is
    # an AppVM carrying template_for_dispvms, never a TemplateVM, so it is
    # always an authoritative source: an offline DVMT yields an offline
    # disposable rather than one handed the gateway's egress (F-J).
    source_tags = set(tpl.tags)
    if _CAPS is None:
        return emit({"ok": False, "error": "birth egress could not be resolved"})
    try:
        actor_vm = app.domains[_principal()]
    except Exception:
        actor_vm = None
    resolved, egress_rule = _CAPS.resolve_birth_egress(
        actor_vm, tpl,
        is_ai_managed=lambda n: (n in app.domains
                                 and "ai-managed" in app.domains[n].tags),
        **({} if getattr(tpl, "klass", None) == "TemplateVM"
           else {"source_authoritative": True}))
    if egress_rule == "birth-egress:unresolved":
        return emit({"ok": False, "error": "birth egress could not be resolved"})

    # ----- Step 1: create the disposable -----
    try:
        disp_name = create_disposable(app, tpl)
    except Exception as e:
        # F-4: same posture as the clone path.
        _audit_summary["error_class"] = type(e).__name__
        return emit({"ok": False, "error": "disposable creation failed"})

    # ----- Step 2: apply ai-managed tag (race window starts here) -----
    # Direct admin calls — see module docstring for why we bypass
    # `app.domains[disp_name]` here (the VMCollection cache lags
    # CreateDisposable and raises KeyError for several seconds).
    try:
        _birth_stamp_direct(app, disp_name, source_tags)
        # Pin the egress EXPLICITLY even when the inherited default already
        # matches, then read it back. An explicit value cannot drift if the
        # DVMT is retargeted mid-life, and the read-back is what §3.4 requires
        # before a disposable is allowed to start. Nothing has started yet, so
        # a mismatch here costs a kill and no leak.
        set_netvm_direct(app, disp_name, resolved)
        got = netvm_name_direct(app, disp_name)
        if got != resolved:
            raise RuntimeError(f"netvm read back as {got!r}, expected {resolved!r}")
    except Exception as tag_err:
        try:
            kill_direct(app, disp_name)
            return emit({"ok": False,
                         "error": f"birth stamp failed (rolled back): {tag_err}"})
        except Exception as kill_err:
            return emit({"ok": False, "error":
                f"birth stamp failed AND kill failed: "
                f"tag-err={tag_err}, kill-err={kill_err}; "
                f"manual cleanup of qube '{disp_name}' required in dom0"})

    return emit({"ok": True, "name": disp_name})


if __name__ == "__main__":
    sys.exit(main())
