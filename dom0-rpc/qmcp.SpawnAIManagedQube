#!/usr/bin/env python3
"""qmcp.SpawnAIManagedQube — create a qube and tag it ai-managed.

Stage A: AppVM only.
Stage D: also DispVMTemplate (persistent disposable template) and DispVM
         (persistent named disposable).

Input  (stdin, JSON): {
    "name":     "<alphanumeric-dashes, 1-31 chars>",
    "template": "<source qube name>",
    "klass":    "AppVM" | "DispVMTemplate" | "DispVM",   (optional, default "AppVM")
    "label":    "<color>",            (optional, default "gray")
    "netvm":    "<ai-managed netvm>", (optional; see netvm defaulting below)
}

`template` constraints by klass:
  - AppVM           → template must be a TemplateVM that is ai-managed.
  - DispVMTemplate  → template must be a TemplateVM that is ai-managed.
                      Internally created as klass=AppVM and then
                      template_for_dispvms is set True. This is the
                      version-agnostic canonical form for a DispVM
                      template (the AppVM-plus-flag pattern works on
                      Qubes 4.0 through 4.3+; some Qubes versions expose
                      admin.vm.Create.DispVMTemplate but with payload
                      requirements that vary across releases).
  - DispVM          → template must be ai-managed AND have
                      template_for_dispvms=True (i.e., a DispVM template,
                      whether the klass is AppVM-with-flag or the distinct
                      DispVMTemplate klass).

Birth egress (Wave 2 Stage 2 — supersedes Stage C's netvm defaulting):
  - "netvm" key omitted → INHERITED, via qmcp_caps.resolve_birth_egress:
    the creation source's netvm, else the calling principal's, else
    /etc/qmcp/birth-egress, else the create is REFUSED.
  - "netvm" key present and null → explicit "no network". De-escalation
    cannot leak, so it needs no approval.
  - "netvm" key present and a string → must be ai-managed AND must equal
    the inherited value. Any other value is escalation-class and refused;
    no tier grants it.

  The Stage C constant `DEFAULT_NETVM = "ai-net-router"` is gone. It was
  fleet-specific (an adopter whose egress qube is named otherwise got
  qubes with no network at all) and, on a fleet with more than one egress
  class, it was the leak §3.4 exists to prevent: an agent working behind
  Tor spawning a clearnet qube that resolves DNS on first boot. AI still
  cannot retarget an existing qube's netvm at any tier.

Output (stdout, JSON):
    {"ok": true,  "name": "<new-vm-name>"}
    {"ok": true,  "name": "<new-vm-name>", "warning": "..."}   (created+tagged but a post-step failed)
    {"ok": false, "error": "<reason>"}

Refuses on: malformed name, name collision, unsupported klass, template not
ai-managed or wrong-shape for the klass, netvm not ai-managed, invalid
label, or Admin API failure. The template and netvm cross-ref refusals
are OPAQUE — missing and untagged collapse to one message that does not
echo the referenced value — so spawn is not an existence oracle on
untagged qube names (aligned with the Set{Property,Feature}AIManaged
cross-refs). Klass-mismatch and template_for_dispvms-missing stay
informative: those fire only after the referenced qube has been
confirmed ai-managed, so AI already knows it exists.

Atomicity: there is a brief window between qube creation and tag application
during which the new qube exists untagged. If tag application fails for any
reason, the script rolls back by removing the qube before returning an
error. A post-condition check confirms the tag is visible before declaring
success; if the post-check fails, the qube is rolled back too. The window
is still visible to concurrent dom0 admin tools (e.g. an operator manually
running qubes-manager during a spawn) but cannot be observed by AI through
the qrexec policy surface.
"""
from __future__ import annotations

import json
import re
import sys

NAME_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,30}$")
ALLOWED_LABELS = {"red", "orange", "yellow", "green", "gray", "blue", "purple", "black"}
ALLOWED_KLASSES = {"AppVM", "DispVMTemplate", "DispVM"}


def _load_budget_lib():
    """Load the sibling qmcp_budget helper by path.

    Stage I-0. The helper lives next to this wrapper in /etc/qubes-rpc/
    (production) and in public/dom0-rpc/ (offline-validation). Loading
    via importlib avoids any sys.path or PYTHONPATH dependency.
    """
    import importlib.util
    import os.path
    here = os.path.dirname(os.path.realpath(__file__))
    spec = importlib.util.spec_from_file_location(
        "qmcp_budget", os.path.join(here, "qmcp_budget.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_AUDIT_SERVICE = "qmcp.SpawnAIManagedQube"
#: Request-derived, whitelisted call summary (qube names / klass / label
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as _load_budget_lib above. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as _load_budget_lib / _load_audit_lib above.
    Returns None on any failure; the tier gate then FAILS CLOSED (denies).
    Unlike the best-effort audit hook, a missing tier resolver must NEVER
    grant authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def _load_birth_lib():
    """Load the sibling qmcp_birth helper by path (Wave 2 Stage 2).

    Same sibling-import shim as the helpers above. Returns None on any failure;
    the create path then FAILS CLOSED (see `_birth_stamp`). It owns the
    authority a created qube is born with, so a missing helper must refuse the
    create — the tier/consent posture, never the best-effort audit one.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_birth", os.path.join(here, "qmcp_birth.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_BIRTH = _load_birth_lib()


def _principal() -> str:
    """The calling principal — the qrexec source domain (D1)."""
    import os
    return os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown"


def _birth_stamp(vm, source_tags) -> None:
    """Wave 2 Stage 2: stamp umbrella + owner + birth tier, inherit
    restrictions, strip inherited privilege, verify, or raise so the caller
    rolls the qube back.

    Supersedes the I-5 `strip_inherited_tier_tags` on this path. The strip is
    still here — it is the `have - want` half of `qmcp_birth.stamp` — but it is
    now one side of a two-sided assertion rather than a lone removal, and the
    birth tier it clamps to comes from `qmcp_tier.resolve_birth_tier` instead
    of being unconditionally "untiered". `app.add_new_vm` creates a FRESH qube
    that copies no tags today; keeping the strip is the version-robust
    guarantee that stays correct if a future qubesadmin starts propagating.
    """
    if _BIRTH is None or _TIER is None:
        raise RuntimeError("birth helper unavailable")
    _BIRTH.stamp(
        _BIRTH.TagIO.for_vm(vm),
        source_tags,
        _principal(),
        _TIER.resolve_birth_tier(tags=source_tags),
        _TIER.UMBRELLA,
        _TIER.QMCP_TIER_TAGS,
    )


def _load_consent_lib():
    """Load the sibling qmcp_consent helper by path (Stage I-6).

    Same sibling-import shim as _load_tier_lib / _load_audit_lib above.
    Returns None on any failure; the consent gate then FAILS CLOSED at the
    call site (a None helper is treated as verdict "unavailable" => deny),
    matching the I-5 tier gate's fail-closed posture, NOT the best-effort
    audit hook.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_consent", os.path.join(here, "qmcp_consent.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CONSENT = _load_consent_lib()


def _load_caps_lib():
    """Load the sibling qmcp_caps decision kernel (Wave 2 Stage 1).

    Same sibling-import shim as qmcp_tier / qmcp_consent / qmcp_audit. Returns
    None on any failure — and unlike the tier and consent gates, a None here is
    BENIGN by design: the kernel runs in SHADOW mode, so its absence must change
    nothing at all. If a later stage makes this a gate, the fail-closed posture
    has to move with it (see qmcp_caps' own docstring).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_caps", os.path.join(here, "qmcp_caps.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CAPS = _load_caps_lib()

#: Wave 2 Stage 1 (SHADOW): set ONLY when the decision kernel disagrees with
#: what this wrapper actually did on capability grounds. Stays None whenever
#: they agree — and on every path where the kernel is unavailable or errored —
#: so emit() omits the key and the audit line stays BYTE-IDENTICAL to
#: pre-Stage-1 (INVARIANCE, the I-6 consent pattern). A populated key IS the
#: divergence log that Stage 3's flip to decide() is gated on.
_shadow = None


def _shadow_note(action, roles, params, wrapper_allowed) -> None:
    """Record kernel-vs-wrapper divergence for this call.

    NEVER raises and NEVER changes behaviour: it only sets `_shadow` for the
    audit line. Guarded here AND inside qmcp_caps.shadow_record, the same
    belt-and-suspenders the I-2 audit hook uses at this boundary.

    `roles` maps the kernel's role names ("target"/"source"/"template"/"dvmt"/
    "backend"/"frontend") to qube objects; `wrapper_allowed` is what THIS
    wrapper decided at this point, so the comparison is like-for-like.
    """
    global _shadow
    if _CAPS is None:
        return
    try:
        import os
        _shadow = _CAPS.shadow_record(
            os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown",
            _AUDIT_SERVICE, action, roles, params,
            wrapper_allowed=wrapper_allowed)
    except Exception:
        _shadow = None

#: Stage I-6 consent verdict for THIS call, recorded on the audit line only
#: when a gate actually ran. Stays None on the empty-gate default (I-6) and
#: on every ungated path, so emit() OMITS the `consent` key and the audit
#: line is byte-identical to pre-I-6 (INVARIANCE). Set to "approved"/"denied"/
#: "timeout"/"unavailable" by _consent_gate only when the daemon was consulted.
_consent_verdict = None


def _consent_gate(action) -> bool:
    """Stage I-6 operator-consent gate. Returns True to proceed, False to
    refuse. The sibling qmcp_consent helper decides from
    /etc/qmcp/consent-policy whether (service, action) is gated at all.

    Under the I-6 empty gate NOTHING is gated: gate() returns (True, "open")
    without touching the daemon, `_consent_verdict` stays None, and the call
    is byte-neutral. Only when a gate actually runs does the verdict get
    recorded for the audit line. FAIL-CLOSED: a missing/broken helper or any
    exception denies with verdict "unavailable" (same posture as the I-5 tier
    gate, opposite of the best-effort audit hook)."""
    global _consent_verdict
    if _CONSENT is None:
        _consent_verdict = "unavailable"
        return False
    try:
        ok, verdict = _CONSENT.gate(_AUDIT_SERVICE, action, _audit_summary)
    except Exception:
        _consent_verdict = "unavailable"
        return False
    # "open" == gate did not run (empty policy). Leave the verdict unset so
    # the audit line omits the key and stays byte-identical to pre-I-6.
    if verdict != "open":
        _consent_verdict = verdict
    return ok


def emit(payload: dict) -> int:
    # Stage I-2: single response funnel so every exit path (this wrapper
    # has several success/warning returns plus fail()) leaves exactly one
    # hash-chained audit line per invocation. Best-effort and defensively
    # guarded so an audit failure can never change what AI sees or whether
    # the operation ran.
    # Stage I-6: pass the consent verdict through; it is None (=> key omitted,
    # byte-identical line) unless a gate actually ran for this call.
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"),
                         consent=_consent_verdict,
                         # Byte-neutral AND deploy-tolerant: the kwarg is
                         # passed only when there IS a divergence. If dom0
                         # still holds a pre-Stage-1 qmcp_audit.py (a partial
                         # deploy — F9's split-brain family), passing
                         # shadow=None unconditionally would raise TypeError
                         # inside this best-effort guard and silently take the
                         # ENTIRE audit line with it. Omitting it keeps every
                         # agreeing call auditable against the old helper.
                         **({} if _shadow is None
                            else {"shadow": _shadow}))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def fail(msg: str) -> int:
    return emit({"ok": False, "error": msg})


def best_effort_remove(app, name: str) -> bool:
    """Try to remove a qube created by this script. Returns True on success."""
    try:
        vm = app.domains[name]
    except Exception:
        return True  # already gone
    try:
        if vm.is_running():
            vm.kill()
    except Exception:
        pass
    try:
        del app.domains[name]
        return True
    except Exception:
        return False


def validate_template(klass: str, tpl, tpl_name: str) -> str | None:
    """Return an error string if `tpl` is unsuitable as a template for `klass`,
    else None. Caller has already verified that `tpl` is ai-managed."""
    if klass in ("AppVM", "DispVMTemplate"):
        if tpl.klass != "TemplateVM":
            return (f"template '{tpl_name}' must be a TemplateVM for klass={klass} "
                    f"(klass is {tpl.klass})")
    elif klass == "DispVM":
        try:
            cap = bool(getattr(tpl, "template_for_dispvms", False))
        except Exception:
            cap = False
        if not cap:
            return (f"template '{tpl_name}' must have template_for_dispvms=True "
                    f"to be a DispVM source (klass is {tpl.klass})")
    return None


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return fail(f"invalid JSON input: {e}")

    name = req.get("name", "")
    template = req.get("template", "")
    klass = req.get("klass", "AppVM")
    label = req.get("label", "gray")
    # Distinguish "key omitted" (default to ai-net-router if usable) from
    # "key explicitly null" (the caller wants no network). req.get("netvm")
    # collapses both to None; we need the key-presence check.
    netvm_specified = "netvm" in req
    netvm = req.get("netvm")
    # Optional persistent-disk request (bytes). When given, the new qube's
    # private volume is grown to it (up to the operator's per-qube cap P); when
    # omitted, the qube keeps the Qubes default. AI declares max sizes freely —
    # only the persistent `private` is metered and capped (qmcp_budget.py).
    private_size = req.get("private_size")
    _audit_summary.update({"name": name, "template": template, "klass": klass,
                           "netvm": netvm, "label": label,
                           "private_size": private_size})

    if not NAME_RE.match(name):
        return fail("name must be alphanumeric + dashes, 1-31 chars, starting with alphanumeric")
    if klass not in ALLOWED_KLASSES:
        return fail(f"klass must be one of: {sorted(ALLOWED_KLASSES)}")
    if label not in ALLOWED_LABELS:
        return fail(f"label must be one of: {sorted(ALLOWED_LABELS)}")
    if private_size is not None:
        try:
            private_size = int(private_size)
        except Exception:
            return fail("private_size must be an integer number of bytes")
        if private_size <= 0:
            return fail("private_size must be a positive number of bytes")

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return fail(f"qubesadmin import failed: {e}")

    if name in app.domains:
        return fail(f"qube '{name}' already exists")

    # Cross-ref: template must be ai-managed. Collapse missing + untagged
    # into one opaque message that does not echo the value — without this
    # collapse, AI can probe the existence of every untagged qube name in
    # dom0 by attempting spawns. Klass-mismatch (validate_template) stays
    # informative: it fires only after the ai-managed check has passed, so
    # AI already knows the referenced template exists.
    if template not in app.domains or "ai-managed" not in app.domains[template].tags:
        return fail("template must reference an ai-managed qube")
    tpl = app.domains[template]
    # Stage I-5: the template must grant CAP_FULL to be a spawn base. Collapse
    # into the SAME opaque cross-ref message as missing/untagged so spawn is no
    # tier oracle (an under-full template is indistinguishable from a
    # non-ai-managed one). Fail-closed.
    _full_ok = _require_full(tpl)
    # Wave 2 Stage 1 (SHADOW): record kernel disagreement only. `klass` feeds the
    # escalation check (TemplateVM). `netvm` is passed but the kernel's
    # birth-egress comparison stays inert here, and deliberately so: Stage 2
    # enforces §3.4 in THIS wrapper (below), before any create, so there is no
    # divergence left for the shadow to record. Handing the kernel a
    # `resolved_netvm` at this point would only re-derive an answer the wrapper
    # is about to act on — a second opinion is not a second enforcement.
    _shadow_note("spawn", {"template": tpl},
                 {"klass": klass, "netvm": netvm}, _full_ok)
    if not _full_ok:
        return fail("template must reference an ai-managed qube")

    # Stage I-6: operator-consent gate on the spawn — authority, so it fires
    # here (after the template CAP_FULL check, before the klass/netvm/budget
    # input-validation and the privileged create, matching the I-5 ordering).
    # Inert under the empty policy; once gated, a refusal/timeout/unavailable
    # collapses to the SAME cross-ref message the template tag/tier denials above
    # emit — fail("template must reference an ai-managed qube"), NOT NOT_FOUND and
    # NOT "not found or refused". Spawn's tag/tier denial IS that cross-ref
    # message (an under-full/untagged template is indistinguishable from a
    # non-ai-managed one), so matching it keeps the consent gate from becoming an
    # oracle once I-7 arms a policy line. Fail-closed (handled inside
    # _consent_gate).
    if not _consent_gate("spawn"):
        return fail("template must reference an ai-managed qube")

    tpl_err = validate_template(klass, tpl, template)
    if tpl_err is not None:
        return fail(tpl_err)

    # ----- Wave 2 Stage 2: birth egress (§3.4) -----
    # Stage C's `DEFAULT_NETVM = "ai-net-router"` constant is GONE. It was
    # fleet-specific and already public: on an adopter whose egress qube has any
    # other name the lookup missed and every spawned qube came up silently with
    # no network. Worse, on a fleet with two egress classes it produced the leak
    # this invariant exists to prevent — an agent working behind Tor spawning a
    # clearnet qube that resolves DNS on first boot (demonstrated on the rig,
    # Stage 0.5). The netvm now comes from the inheritance chain instead.
    #
    # The source's klass decides whether its netvm is authoritative: a
    # TemplateVM's netvm is an update path, not a workload egress, so a
    # template-based spawn falls through to the calling principal's egress. A
    # DVMT source (klass=DispVM spawns) is a workload and answers for itself,
    # including when the answer is "no network" (F-J).
    if _CAPS is None:
        return fail("birth egress could not be resolved")
    try:
        actor_vm = app.domains[_principal()]
    except Exception:
        actor_vm = None
    resolved, egress_rule = _CAPS.resolve_birth_egress(
        actor_vm, tpl,
        is_ai_managed=lambda n: (n in app.domains
                                 and "ai-managed" in app.domains[n].tags),
        **({} if getattr(tpl, "klass", None) == "TemplateVM"
           else {"source_authoritative": True}))
    # Row 4 is checked per branch, NOT up front, and the difference is not
    # cosmetic: an explicit `netvm: null` is de-escalation and cannot leak, so
    # refusing it because the INHERITANCE chain failed to resolve would deny a
    # request that never needed an inherited value. Refuse only where the
    # resolved value is actually load-bearing.
    unresolved = (egress_rule == "birth-egress:unresolved")

    if netvm_specified:
        # Explicit null stays allowed with no approval: de-escalation cannot
        # leak (brief §3.4's carve-out). The provides_network exception there
        # cannot apply to a create — a qube is never born providing network.
        if netvm is not None:
            # Opaque cross-ref FIRST, exactly as before, so an out-of-scope
            # name still collapses to the same message and the egress check
            # below can never be read as an existence oracle.
            if netvm not in app.domains or "ai-managed" not in app.domains[netvm].tags:
                return fail("netvm must reference an ai-managed qube")
            if unresolved or str(netvm) != str(resolved):
                # Escalation-class: a birth egress differing from the creator's
                # is exactly §3.4's deanonymisation event. Informative on
                # purpose — it fires only after the referenced qube has been
                # confirmed ai-managed, so AI already knows it exists. An
                # unresolved chain lands here too: with nothing to match
                # against, a pinned value cannot be shown to be the inherited
                # one, and unverifiable is refused.
                return fail("netvm must match the inherited birth egress")
    elif unresolved:
        # Row 4 — the honest failure, and only here does it belong. Refusing
        # beats birthing a qube on a silently wrong (or absent) egress, which
        # is what the deleted DEFAULT_NETVM fallback did. Nothing in this
        # message names a qube, so it is no existence oracle.
        return fail("birth egress could not be resolved")
    else:
        netvm = resolved

    # ----- I-0 budget gate (persistent-footprint basis, 2026-06-12) -----
    # Two checks, both opaque-on-refuse:
    #   1. Per-qube cap: a requested private_size above the operator's
    #      `/etc/qmcp/private-cap` (P) is refused — AI may spawn big qubes, but
    #      only under the limit.
    #   2. Global cap: refuse if the projected persistent sum would exceed
    #      `/etc/qmcp/pool-cap`. The estimate is just this qube's private (the
    #      requested size, or the 2 GiB default) — its root is COW from the
    #      template (real persistent delta ~0) and is not counted. Measurement
    #      mirrors qmcp.GetPoolStats (which imports the same summer), so AI's
    #      (used, cap, headroom) predicts this refusal. Cap-missing fails closed.
    try:
        budget = _load_budget_lib()
    except Exception as e:
        return fail(f"budget helper load failed: {e}")
    psize_err = budget.check_private_size(private_size)
    if psize_err is not None:
        return fail(psize_err)
    # Serialize the gate->create critical section so concurrent spawns can't both
    # pass the same pre-create `used` and overshoot the cap. Held until this
    # one-shot process exits (best-effort; a create proceeds even unlocked).
    _budget_lock_fd = budget.acquire_create_lock()
    cap_err = budget.check_cap_for_create(app, tpl, requested_private=private_size)
    if cap_err is not None:
        return fail(cap_err)

    # ----- Step 1: create the qube -----
    # DispVMTemplate is created as klass=AppVM and then promoted via
    # template_for_dispvms=True in Step 3. The dedicated DispVMTemplate
    # admin endpoint exists on some Qubes versions but its payload shape
    # varies; the AppVM-plus-flag pattern is the version-agnostic form.
    create_klass = "AppVM" if klass == "DispVMTemplate" else klass
    try:
        new_vm = app.add_new_vm(create_klass, name, label, template=template)
    except Exception as e:
        return fail(f"create failed: {e}")

    # ----- Step 2: apply the birth stamp (race window starts here) -----
    try:
        _birth_stamp(new_vm, set(tpl.tags))
    except Exception as e:
        # Roll back: untagged qube must not persist.
        removed = best_effort_remove(app, name)
        if removed:
            return fail(f"tag application failed (rolled back): {e}")
        return fail(
            f"tag application failed AND rollback failed: {e}; "
            f"manual cleanup of qube '{name}' required in dom0"
        )

    # ----- Step 3: for DispVMTemplate, force-set template_for_dispvms=True.
    # The "DispVMTemplate" klass enables this automatically in current Qubes,
    # but we set it explicitly so the post-condition is unambiguous and so the
    # script keeps working if the klass-default ever drifts. Non-fatal: the
    # tag is already applied, so the qube IS in the ai-managed scope.
    if klass == "DispVMTemplate":
        try:
            if not getattr(new_vm, "template_for_dispvms", False):
                new_vm.template_for_dispvms = True
        except Exception as e:
            return emit({
                "ok": True,
                "name": name,
                "warning": f"qube created and tagged but template_for_dispvms set failed: {e}",
            })

    # ----- Step 4: netvm assignment (always explicit — qvm-create silently
    # inherits the system default netvm, which would put AI traffic through
    # the operator's chosen upstream. We override unconditionally so the
    # request shape determines the netvm: ai-net-router (default), a
    # specified ai-managed qube, or None.) -----
    #
    # Wave 2 Stage 2: this is now FATAL, where it used to return ok=true with a
    # warning. A qube created and tagged but sitting on the system-default
    # netvm is on an egress nobody chose — the operator's own upstream, quite
    # possibly outside the umbrella entirely. "Burn, don't repair": a create
    # whose egress cannot be proven is rolled back, never handed to AI with a
    # note attached. Nothing has started at this point, so nothing has leaked;
    # that is only true because this runs before the qube's first boot.
    try:
        if netvm is None:
            new_vm.netvm = None
        else:
            new_vm.netvm = app.domains[netvm]
        # Read back. Setting a property and trusting the setter is how the
        # disposable path (F-F) went wrong; the platform is not ours to assume.
        got = getattr(new_vm, "netvm", None)
        got_name = None if got is None else str(getattr(got, "name", got))
        if got_name != (None if netvm is None else str(netvm)):
            raise RuntimeError(f"netvm read back as {got_name!r}")
    except Exception as e:
        removed = best_effort_remove(app, name)
        if removed:
            return fail(f"netvm assignment failed (rolled back): {e}")
        return fail(
            f"netvm assignment failed AND rollback failed: {e}; "
            f"manual cleanup of qube '{name}' required in dom0"
        )

    # ----- Step 5: grow the private volume if a (cap-checked) size was requested.
    # Non-fatal: the qube is created, tagged, and in scope; a resize failure just
    # leaves the Qubes-default private (the warning tells AI). Qubes only grows a
    # volume, never shrinks, so a sub-default request is a harmless no-op. The
    # size was already clamped to the per-qube cap P by check_private_size above.
    if private_size is not None:
        try:
            new_vm.volumes["private"].resize(int(private_size))
        except Exception as e:
            return emit({
                "ok": True,
                "name": name,
                "warning": f"qube created and tagged but private resize failed: {e}",
            })

    return emit({"ok": True, "name": name})


if __name__ == "__main__":
    sys.exit(main())
