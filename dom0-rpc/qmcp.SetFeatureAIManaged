    helper is treated as verdict "unavailable" => deny), matching the I-5
    tier gate's fail-closed posture, NOT the best-effort audit hook.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_consent", os.path.join(here, "qmcp_consent.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CONSENT = _load_consent_lib()


def _load_caps_lib():
    """Load the sibling qmcp_caps decision kernel (Wave 2 Stage 1).

    Same sibling-import shim as qmcp_tier / qmcp_consent / qmcp_audit. Returns
    None on any failure — and unlike the tier and consent gates, a None here is
    BENIGN by design: the kernel runs in SHADOW mode, so its absence must change
    nothing at all. If a later stage makes this a gate, the fail-closed posture
    has to move with it (see qmcp_caps' own docstring).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_caps", os.path.join(here, "qmcp_caps.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CAPS = _load_caps_lib()

def _load_enforce_lib():
    """Load the sibling qmcp_enforce mode flag (Wave 2 Stage 3b).

    Same sibling-import shim as qmcp_caps / qmcp_tier / qmcp_consent. Unlike
    Stage 1's `_CAPS`, a None here is NOT benign — this module is what decides
    whether the kernel binds — so `_enforce_mode` resolves the ambiguity from
    the operator's own file rather than picking a constant default.
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_enforce", os.path.join(here, "qmcp_enforce.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_ENFORCE = _load_enforce_lib()

#: `/etc/qmcp/enforce-mode`, duplicated as a literal for the partial-deploy
#: branch below — which runs precisely when importing the module that owns the
#: constant has already failed. A literal cannot fail to load (the same reason
#: `qmcp_budget` carries its own copy of `TOMBSTONE_PREFIX`).
_MODE_PATH = "/etc/qmcp/enforce-mode"

#: Resolved once per call. These wrappers are one-shot processes, so caching
#: costs nothing and guarantees that a mode file edited mid-call cannot make
#: one gate in this process disagree with the next.
_MODE = None


def _enforce_mode() -> str:
    """This call's enforcement mode. Never raises; always returns a mode word.

    The case worth writing down is a PARTIAL DEPLOY — Stage 3c's wrappers
    installed while `qmcp_enforce.py` is not. That is the F9 split-brain family
    and the same shape as the additive-kwarg blackout that silently killed the
    I-2 audit line, so it gets an explicit branch rather than a default:

      module missing, flag file ABSENT   -> "shadow". The shipped default is
        shadow, so an operator who never asked for enforcement gets exactly the
        Stage 1 behaviour. This direction cannot arm a widening.
      module missing, flag file PRESENT  -> "strict". The operator DID ask for
        enforcement and we cannot resolve which kind. Strict is the only mode
        more restrictive than both of its neighbours — the same reason
        `qmcp_enforce.read_mode` falls there on a malformed value.

    Neither constant default is safe alone: "shadow" would silently discard an
    enforcement the operator configured, and "strict"/"enforce" would arm one
    they never asked for, on nothing but a failed import.
    """
    global _MODE
    if _MODE is not None:
        return _MODE
    if _ENFORCE is not None:
        try:
            _MODE = _ENFORCE.read_mode()
        except Exception:
            _MODE = "strict"
        return _MODE
    try:
        import os.path
        _MODE = "strict" if os.path.exists(_MODE_PATH) else "shadow"
    except Exception:
        _MODE = "strict"
    return _MODE


def _enforcing() -> bool:
    """True iff the kernel's verdict can change what this wrapper does.

    Read by the side effects that arm WITH enforcement rather than with the
    install — today that is the Stage 3a tombstone in `qmcp.LifecycleAIManaged`.
    Under shadow every one of them must stay dormant, which is what keeps this
    stage byte-neutral at install and revertible in one write.
    """
    return _enforce_mode() != "shadow"


#: Wave 2 Stage 1/3c: set ONLY when the decision kernel and this wrapper reach
#: different answers. Stays None whenever they agree — and on every path where
#: the kernel is unavailable or errored — so emit() omits the key and the audit
#: line stays BYTE-IDENTICAL to pre-Stage-1 (INVARIANCE, the I-6 consent
#: pattern).
#:
#: The key's MEANING depends on the mode, and the two readings are different
#: questions. Under shadow it is "the kernel would have decided otherwise" —
#: the divergence log Stage 3c's flip is gated on. Under strict/enforce it is
#: "enforcement CHANGED the outcome", and carries `mode` + `effective` as well,
#: because by then the interesting fact is not that the two disagreed but which
#: one won. Both are fixed vocabulary; neither forwards the kernel's `reason`
#: prose, per the I-2 caller-sanitises contract.
_shadow = None


def _gate(action, roles, params, wrapper_allowed) -> bool:
    """The capability decision for this call. Wave 2 Stage 3c.

    Replaces Stage 1's `_shadow_note`, which computed the kernel's verdict and
    threw it away. Returns whether the call may proceed. NEVER raises: a gate
    that can throw into a wrapper's mutation path is worse than no gate.

    **What this decides, and what it does not.** `wrapper_allowed` is this
    wrapper's own CAPABILITY verdict at this point — the I-5 tier gate — and the
    kernel answers that question plus the escalation class and the guarded hard
    class. Everything else the wrapper checks is unconditional and still runs
    exactly where it did: argument shape, `SETTABLE_PROPS`, the cross-reference
    guards, the birth-egress inheritance (§3.4, enforced in the create wrappers
    and deliberately NOT in the kernel), the I-0 pool cap, and the I-6 consent
    gate. So `enforce` means "the kernel decides THIS", never "the kernel
    decides everything" — the same caution `qmcp_enforce`'s docstring gives for
    the six policy-decided surfaces it also cannot reach.

    **GATE is not an allow.** `qmcp_caps` returns it for the guarded hard class
    and for a guarded list it could not read; Stage 7 arms that channel. Until
    then a wrapper that reaches it must refuse — the same fail-closed posture
    `_consent_gate` already takes on an unavailable daemon.

    `roles` maps the kernel's role names ("target"/"source"/"template"/"dvmt"/
    "backend"/"frontend") to qube objects; `params` carries the operation's
    scalar arguments.
    """
    global _shadow
    mode = _enforce_mode()

    if _ENFORCE is None:
        # Partial deploy. `_enforce_mode` has already chosen between the two
        # honest readings; refusing outright is at least as strict as either,
        # and re-implementing the mode semantics here is what this module
        # exists to prevent.
        return bool(wrapper_allowed) if mode == "shadow" else False

    verdict, rule = None, "kernel-unavailable"
    if _CAPS is not None:
        try:
            import os
            dec = _CAPS.decide(
                os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown",
                _AUDIT_SERVICE, action, roles, params)
            verdict, rule = dec.verdict, dec.rule
        except Exception:
            verdict, rule = None, "kernel-call-failed"

    if verdict is None:
        # The kernel gave NO opinion — the module is absent, or calling it threw
        # before it could apply its own fail-closed posture. (An internal error
        # the kernel caught itself arrives as a real DENY with rule
        # "kernel-error" and is treated as an opinion, because it is one.)
        #
        # Under SHADOW this must change NOTHING and log NOTHING: Stage 1's
        # promise is that a wrapper whose kernel failed to load behaves exactly
        # as it did before Stage 1, and a divergence line here would invent a
        # disagreement out of an absence — poisoning the very log the flip is
        # gated on. Under any enforcing mode the opposite holds: an opinion we
        # cannot read is not an allow.
        if mode == _ENFORCE.SHADOW:
            return bool(wrapper_allowed)
        verdict = _ENFORCE.DENY

    effective = _ENFORCE.effective_verdict(mode, bool(wrapper_allowed), verdict)
    allowed = effective == _ENFORCE.ALLOW

    try:
        if mode == _ENFORCE.SHADOW:
            # Stage 1's comparison, preserved EXACTLY — including that GATE
            # counts as "not allowed" — so a shadow-mode audit line is
            # byte-identical to the one this stage replaced. Anything else
            # would silently rewrite the divergence history the flip is
            # measured against.
            diverged = (verdict == _ENFORCE.ALLOW) != bool(wrapper_allowed)
        else:
            # Once enforcing, the question is whether enforcement CHANGED what
            # happened — not whether the two opinions differed. A kernel GATE
            # over a wrapper DENY is a different opinion and the same outcome,
            # and logging it would bury the lines that matter.
            diverged = allowed != bool(wrapper_allowed)
        if diverged:
            _shadow = {
                "kernel": verdict,
                "rule": rule,
                "wrapper": _ENFORCE.ALLOW if wrapper_allowed else _ENFORCE.DENY,
            }
            if mode != _ENFORCE.SHADOW:
                _shadow["mode"] = mode
                _shadow["effective"] = effective
    except Exception:
        _shadow = None

    return allowed

#: Stage I-6 consent verdict for THIS call, recorded on the audit line only
#: when a gate actually ran. Stays None on the empty-gate default (I-6) and
#: on every ungated path, so emit() OMITS the `consent` key and the audit
#: line is byte-identical to pre-I-6 (INVARIANCE). Set to "approved"/"denied"/
#: "timeout"/"unavailable" by _consent_gate only when the daemon was consulted.
_consent_verdict = None


def _consent_gate(action) -> bool:
    """Stage I-6 operator-consent gate. Returns True to proceed, False to
    refuse. The sibling qmcp_consent helper decides from
    /etc/qmcp/consent-policy whether (service, action) is gated at all.

    Under the I-6 empty gate NOTHING is gated: gate() returns (True, "open")
    without touching the daemon, `_consent_verdict` stays None, and the call
    is byte-neutral. Only when a gate actually runs does the verdict get
    recorded for the audit line. FAIL-CLOSED: a missing/broken helper or any
    exception denies with verdict "unavailable" (same posture as the I-5 tier
    gate, opposite of the best-effort audit hook)."""
    global _consent_verdict
    if _CONSENT is None:
        _consent_verdict = "unavailable"
        return False
    try:
        ok, verdict = _CONSENT.gate(_AUDIT_SERVICE, action, _audit_summary)
    except Exception:
        _consent_verdict = "unavailable"
        return False
    # "open" == gate did not run (empty policy). Leave the verdict unset so
    # the audit line omits the key and stays byte-identical to pre-I-6.
    if verdict != "open":
        _consent_verdict = verdict
    return ok


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    # Stage I-6: pass the consent verdict through; it is None (=> key omitted,
    # byte-identical line) unless a gate actually ran for this call.
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"),
                         consent=_consent_verdict,
                         # Byte-neutral AND deploy-tolerant: the kwarg is
                         # passed only when there IS a divergence. If dom0
                         # still holds a pre-Stage-1 qmcp_audit.py (a partial
                         # deploy — F9's split-brain family), passing
                         # shadow=None unconditionally would raise TypeError
                         # inside this best-effort guard and silently take the
                         # ENTIRE audit line with it. Omitting it keeps every
                         # agreeing call auditable against the old helper.
                         **({} if _shadow is None
                            else {"shadow": _shadow}))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def coerce_value(value) -> str:
    """Coerce a JSON value to the Qubes feature string convention.

    True -> "1", False -> "" (the unset-equivalent falsy value Qubes
    reads as off), everything else -> str(value). `None` is handled by
    the caller (rejected) before reaching here."""
    if isinstance(value, bool):
        return "1" if value else ""
    return str(value)


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        print(f"qmcp.SetFeatureAIManaged: invalid JSON input: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "invalid input"})

    name = req.get("name", "")
    feature = req.get("feature", "")
    value = req.get("value")
    # Whitelist: name + feature KEY only. The feature `value` is never
    # logged (it can carry data the audit log must not retain).
    _audit_summary.update({"name": name, "feature": feature})
    if not name or not feature:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        print(f"qmcp.SetFeatureAIManaged: qubesadmin import failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "feature.Set failed"})

    # Existence-or-tag check — opaque "not found" for missing or untagged,
    # matching qmcp.GetPropertyAIManaged's existence-oracle stance.
    if name not in app.domains:
        return emit(NOT_FOUND)
    vm = app.domains[name]
    if "ai-managed" not in vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: feature-set requires CAP_FULL on the target. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged target (no tier
    # oracle), BEFORE the denied-key / cross-ref checks (authority first).
    _full_ok = _require_full(vm)
    # Wave 2 Stage 1 (SHADOW): record kernel disagreement only.
    if not _gate("set-feature", {"target": vm}, {}, _full_ok):
        return emit(NOT_FOUND)

    # Stage I-6: operator-consent gate — authority, so it fires here (after the
    # tier check, before the denied-key / cross-ref input-validation, matching
    # the I-5 ordering). Inert under the empty policy; once gated, a refusal/
    # timeout/unavailable collapses to the same opaque NOT_FOUND as an
    # untagged/under-tier target (the tag AND tier denials above both emit
    # NOT_FOUND), so it is no consent oracle. Fail-closed (in _consent_gate).
    if not _consent_gate("set-feature"):
        return emit(NOT_FOUND)

    # Denied keys — the target IS ai-managed (AI can see it via
    # ListAIManagedQubes), so an informative refusal leaks nothing about
    # other qubes.
    if feature in DENIED_FEATURE_KEYS:
        return emit({"ok": False, "error": f"feature '{feature}' is operator-only"})

    # Reserved namespace — same informative-refusal reasoning as DENIED_FEATURE_KEYS
    # above: the target is already known to AI via ListAIManagedQubes, so naming
    # the rule leaks nothing about other qubes.
    if feature.startswith(DENIED_FEATURE_PREFIXES):
        reserved = "/".join(f"{p}*" for p in DENIED_FEATURE_PREFIXES)
        return emit({"ok": False, "error":
                     f"feature namespace {reserved} is reserved"})

    # Cross-VM keys — value must name an ai-managed qube. Collapse
    # "missing" and "untagged" to one opaque message so AI cannot probe
    # the existence of untagged qubes through this surface.
    if feature in CROSS_REF_FEATURE_KEYS:
        opaque = {"ok": False,
                  "error": f"cross-VM feature '{feature}' must reference an ai-managed qube"}
        if not isinstance(value, str) or not value:
            return emit(opaque)
        # Short-circuit: don't index app.domains[value] unless value is present.
        if value not in app.domains or "ai-managed" not in app.domains[value].tags:
            return emit(opaque)

    if value is None:
        return emit({"ok": False, "error":
                     "value must be a string, integer, or boolean "
                     "(null/remove is operator-only)"})

    value_str = coerce_value(value)

    try:
        vm.features[feature] = value_str
    except Exception as e:
        # Stage G0e (finding [9]): opaque to AI (raw {e} can name an out-of-scope
        # qube); detail to dom0 stderr.
        print(f"qmcp.SetFeatureAIManaged: feature.Set failed: {e}", file=sys.stderr)
        return emit({"ok": False, "error": "feature.Set failed"})

    # Live read-back from qubesd (Features.__getitem__ is not cached) so
    # the caller can confirm the round-trip.
    try:
        readback = vm.features.get(feature, None)
    except Exception:
        readback = None

    return emit({"ok": True, "feature": feature, "value": readback})


if __name__ == "__main__":
    sys.exit(main())
