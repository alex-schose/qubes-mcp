_CONSENT = _load_consent_lib()


def _load_caps_lib():
    """Load the sibling qmcp_caps decision kernel (Wave 2 Stage 1).

    Same sibling-import shim as qmcp_tier / qmcp_consent / qmcp_audit. Returns
    None on any failure — and unlike the tier and consent gates, a None here is
    BENIGN by design: the kernel runs in SHADOW mode, so its absence must change
    nothing at all. If a later stage makes this a gate, the fail-closed posture
    has to move with it (see qmcp_caps' own docstring).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_caps", os.path.join(here, "qmcp_caps.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CAPS = _load_caps_lib()

#: Wave 2 Stage 1 (SHADOW): set ONLY when the decision kernel disagrees with
#: what this wrapper actually did on capability grounds. Stays None whenever
#: they agree — and on every path where the kernel is unavailable or errored —
#: so emit() omits the key and the audit line stays BYTE-IDENTICAL to
#: pre-Stage-1 (INVARIANCE, the I-6 consent pattern). A populated key IS the
#: divergence log that Stage 3's flip to decide() is gated on.
_shadow = None


def _shadow_note(action, roles, params, wrapper_allowed) -> None:
    """Record kernel-vs-wrapper divergence for this call.

    NEVER raises and NEVER changes behaviour: it only sets `_shadow` for the
    audit line. Guarded here AND inside qmcp_caps.shadow_record, the same
    belt-and-suspenders the I-2 audit hook uses at this boundary.

    `roles` maps the kernel's role names ("target"/"source"/"template"/"dvmt"/
    "backend"/"frontend") to qube objects; `wrapper_allowed` is what THIS
    wrapper decided at this point, so the comparison is like-for-like.
    """
    global _shadow
    if _CAPS is None:
        return
    try:
        import os
        _shadow = _CAPS.shadow_record(
            os.environ.get("QREXEC_REMOTE_DOMAIN") or "unknown",
            _AUDIT_SERVICE, action, roles, params,
            wrapper_allowed=wrapper_allowed)
    except Exception:
        _shadow = None

#: Stage I-6 consent verdict for THIS call, recorded on the audit line only
#: when a gate actually ran. Stays None on the empty-gate default (I-6) and
#: on every ungated path, so emit() OMITS the `consent` key and the audit
#: line is byte-identical to pre-I-6 (INVARIANCE). Set to "approved"/"denied"/
#: "timeout"/"unavailable" by _consent_gate only when the daemon was consulted.
_consent_verdict = None


def _consent_gate(action) -> bool:
    """Stage I-6 operator-consent gate. Returns True to proceed, False to
    refuse. The sibling qmcp_consent helper decides from
    /etc/qmcp/consent-policy whether (service, action) is gated at all.

    Under the I-6 empty gate NOTHING is gated: gate() returns (True, "open")
    without touching the daemon, `_consent_verdict` stays None, and the call
    is byte-neutral. Only when a gate actually runs does the verdict get
    recorded for the audit line. FAIL-CLOSED: a missing/broken helper or any
    exception denies with verdict "unavailable" (same posture as the I-5 tier
    gate, opposite of the best-effort audit hook)."""
    global _consent_verdict
    if _CONSENT is None:
        _consent_verdict = "unavailable"
        return False
    try:
        ok, verdict = _CONSENT.gate(_AUDIT_SERVICE, action, _audit_summary)
    except Exception:
        _consent_verdict = "unavailable"
        return False
    # "open" == gate did not run (empty policy). Leave the verdict unset so
    # the audit line omits the key and stays byte-identical to pre-I-6.
    if verdict != "open":
        _consent_verdict = verdict
    return ok


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    # Stage I-6: pass the consent verdict through; it is None (=> key omitted,
    # byte-identical line) unless a gate actually ran for this call.
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"),
                         consent=_consent_verdict,
                         # Byte-neutral AND deploy-tolerant: the kwarg is
                         # passed only when there IS a divergence. If dom0
                         # still holds a pre-Stage-1 qmcp_audit.py (a partial
                         # deploy — F9's split-brain family), passing
                         # shadow=None unconditionally would raise TypeError
                         # inside this best-effort guard and silently take the
                         # ENTIRE audit line with it. Omitting it keeps every
                         # agreeing call auditable against the old helper.
                         **({} if _shadow is None
                            else {"shadow": _shadow}))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def netvm_name(vm):
    """A qube's netvm as a plain name, or None. Used for the birth-egress
    read-back: the property yields a VM object, and comparing objects to the
    name the chain resolved would silently never match."""
    try:
        got = getattr(vm, "netvm", None)
    except Exception:
        return None
    return None if got is None else str(getattr(got, "name", got))


def best_effort_remove(app, name: str) -> bool:
    """Try to remove a qube created by this script. Returns True on success."""
    try:
        vm = app.domains[name]
    except Exception:
        return True  # already gone
    try:
        if vm.is_running():
            vm.kill()
    except Exception:
        pass
    try:
        del app.domains[name]
        return True
    except Exception:
        return False


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return emit({"ok": False, "error": f"invalid JSON input: {e}"})

    source = req.get("source", "")
    name = req.get("name", "")
    _audit_summary.update({"source": source, "name": name})

    if not NAME_RE.match(name):
        return emit({"ok": False, "error":
            "name must be alphanumeric + dashes, 1-31 chars, starting with alphanumeric"})

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    # Source visibility check — collapse "doesn't exist" and "not ai-managed"
    # to the same opaque "not found" so the clone surface cannot be used as
    # an existence oracle for untagged qubes.
    if source not in app.domains:
        return emit(NOT_FOUND)
    src_vm = app.domains[source]
    # Snapshot the source's tags BEFORE anything is created: the birth stamp
    # clamps privilege off this set and inherits restrictions from it, and
    # reading it back off the clone instead would be reading our own output.
    source_tags = set(src_vm.tags)
    if "ai-managed" not in src_vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: clone requires CAP_FULL on the SOURCE qube. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged source (no tier
    # oracle).
    _full_ok = _require_full(src_vm)
    # Wave 2 Stage 1 (SHADOW): record kernel disagreement only. The kernel gates
    # the SOURCE, matching this wrapper; the birth-egress half of the clone path
    # is Stage 2's and is not asserted here (no `resolved_netvm` to compare to).
    _shadow_note("clone", {"source": src_vm}, {}, _full_ok)
    if not _full_ok:
        return emit(NOT_FOUND)

    # Stage I-6: operator-consent gate on the clone — authority, so it fires
    # here (after the source CAP_FULL check, before the name-collision / budget
    # input-validation and the privileged clone_vm, matching the I-5 ordering).
    # Inert under the empty policy; once gated, a refusal/timeout/unavailable
    # collapses to the same opaque NOT_FOUND as an untagged/under-tier source
    # (the tag AND tier denials above both emit NOT_FOUND), so it is no consent
    # oracle. Fail-closed (handled inside _consent_gate).
    if not _consent_gate("clone"):
        return emit(NOT_FOUND)

    if name in app.domains:
        return emit({"ok": False, "error": f"qube '{name}' already exists"})

    # ----- Wave 2 Stage 2: birth egress (§3.4) -----
    # `clone_vm` copies the source's netvm, so the clone is ALREADY born on the
    # inherited path in the common case. This resolves the same answer up front
    # anyway and verifies it after, for two reasons: the copy is qubesadmin's
    # behaviour rather than our guarantee (the I-5 lesson — the mock agreed
    # with us instead of with Qubes), and a source sitting on an egress outside
    # the umbrella must REFUSE rather than silently re-home its child.
    # A TemplateVM source is not authoritative: a template's netvm is an update
    # path, not a workload egress, so a cloned template lands on the calling
    # principal's egress instead of the operator's upstream.
    if _CAPS is None:
        return emit({"ok": False, "error": "birth egress could not be resolved"})
    try:
        actor_vm = app.domains[_principal()]
    except Exception:
        actor_vm = None
    resolved, egress_rule = _CAPS.resolve_birth_egress(
        actor_vm, src_vm,
        is_ai_managed=lambda n: (n in app.domains
                                 and "ai-managed" in app.domains[n].tags),
        **({} if getattr(src_vm, "klass", None) == "TemplateVM"
           else {"source_authoritative": True}))
    if egress_rule == "birth-egress:unresolved":
        return emit({"ok": False, "error": "birth egress could not be resolved"})

    # ----- I-0 budget gate (persistent-footprint basis, 2026-06-12) -----
    # Refuse if the projected persistent sum would exceed `/etc/qmcp/pool-cap`.
    # A clone COPIES the source's volumes, so its estimate is the source's full
    # PERSISTENT footprint (private always; root too when the source's klass
    # persists root — e.g. cloning a TemplateVM). is_clone=True selects that
    # estimate. Measurement mirrors qmcp.GetPoolStats (shared summer); cap-
    # missing fails closed with the same opaque message.
    try:
        budget = _load_budget_lib()
    except Exception as e:
        return emit({"ok": False, "error": f"budget helper load failed: {e}"})
    # Serialize the gate->create critical section (see qmcp_budget.acquire_create_lock);
    # held until this one-shot process exits. Best-effort.
    _budget_lock_fd = budget.acquire_create_lock()
    cap_err = budget.check_cap_for_create(app, src_vm, is_clone=True)
    if cap_err is not None:
        return emit({"ok": False, "error": cap_err})

    # ----- Step 1: clone the qube -----
    try:
        new_vm = app.clone_vm(src_vm, name)
    except Exception as e:
        return emit({"ok": False, "error": f"clone failed: {e}"})

    # ----- Step 2: birth stamp + birth egress (race window) -----
    # Both are inside one try so a failure in either rolls the clone back. A
    # clone whose authority OR whose egress we could not prove is exactly the
    # qube that must not survive to be started ("burn, don't repair" — nothing
    # has booted yet, so nothing has leaked).
    try:
        _birth_stamp(new_vm, source_tags)
        if netvm_name(new_vm) != resolved:
            new_vm.netvm = None if resolved is None else app.domains[resolved]
        got = netvm_name(new_vm)
        if got != resolved:
            raise RuntimeError(f"netvm read back as {got!r}, expected {resolved!r}")
    except Exception as e:
        removed = best_effort_remove(app, name)
        if removed:
            return emit({"ok": False,
                         "error": f"birth stamp failed (rolled back): {e}"})
        return emit({"ok": False, "error":
            f"birth stamp failed AND rollback failed: {e}; "
            f"manual cleanup of qube '{name}' required in dom0"})

    return emit({"ok": True, "name": name})


if __name__ == "__main__":
    sys.exit(main())
