#!/usr/bin/env python3
"""qmcp.SetPropertyAIManaged — write a property on an ai-managed qube.

Cross-reference validation: if the property is one of {template, netvm,
default_dispvm}, the value (a qube name) must itself be ai-managed.
This prevents AI from reaching out of its sandbox by pointing its
qubes' template/netvm/dispvm at the operator's qubes. The cross-ref
refusal is OPAQUE — missing and untagged collapse to one message that
does not echo the referenced value — so this surface is not an
existence oracle (aligned with qmcp.SetFeatureAIManaged's cross-ref).

Egress-qube invariant (Stage C): netvm changes are refused on any
ai-managed qube whose provides_network is true. The intent is that
the operator-designated egress qube (ai-net-router by convention) has
its upstream chosen by the operator in dom0; AI cannot reroute its
own traffic by mutating that pointer. This message stays informative —
it fires only after the target has been confirmed ai-managed, so AI
already has the bit it would learn from it.

Input  (stdin, JSON): {"name": "<qube>", "property": "<prop>", "value": <value>}
Output (stdout, JSON):
    {"ok": true}
    {"ok": false, "error": "not found"}    -- target not ai-managed (indistinguishable from nonexistent)
    {"ok": false, "error": "<reason>"}     -- cross-ref violation (opaque), egress invariant, set failure, etc.
"""
from __future__ import annotations

import json
import sys

CROSS_REF_PROPS = {"template", "netvm", "default_dispvm"}
NOT_FOUND = {"ok": False, "error": "not found"}


_AUDIT_SERVICE = "qmcp.SetPropertyAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return emit(NOT_FOUND)

    name = req.get("name", "")
    prop = req.get("property", "")
    value = req.get("value")
    # Whitelist: name + property KEY only. The property `value` is never
    # logged (it can carry data the audit log must not retain).
    _audit_summary.update({"name": name, "property": prop})
    if not name or not prop:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    if name not in app.domains:
        return emit(NOT_FOUND)
    vm = app.domains[name]
    if "ai-managed" not in vm.tags:
        return emit(NOT_FOUND)

    # Stage I-5: property-set requires CAP_FULL on the target. Fail-closed;
    # collapses to the same opaque NOT_FOUND as an untagged target (no tier
    # oracle), and fires BEFORE the egress / cross-ref checks so an
    # under-tiered qube gets no semantic feedback (authority before
    # input-validation).
    if not _require_full(vm):
        return emit(NOT_FOUND)

    # Egress invariant: AI may not retarget the upstream of a network-providing
    # qube. The operator owns that pointer (in dom0) so they can route all AI
    # traffic through Tor, a VPN, or sys-firewall by flipping one prefs line.
    if prop == "netvm":
        try:
            provides_net = bool(getattr(vm, "provides_network", False))
        except Exception:
            provides_net = False
        if provides_net:
            return emit({"ok": False,
                         "error": "netvm of a network-providing qube is operator-only"})

    # Cross-reference validation: resolve qube-name values to VM objects and
    # refuse if the referenced VM isn't ai-managed. The refusal collapses
    # "missing" and "untagged" to a single opaque message that does not
    # echo the referenced value — same shape as qmcp.SetFeatureAIManaged.
    # Without the collapse this surface is an existence oracle on every
    # untagged qube name in dom0.
    if prop in CROSS_REF_PROPS:
        if value is not None:
            if not isinstance(value, str):
                return emit({"ok": False,
                             "error": f"{prop} value must be a qube name string or null"})
            opaque = {"ok": False,
                      "error": f"cross-ref property '{prop}' must reference an ai-managed qube"}
            if not value:
                return emit(opaque)
            if value not in app.domains or "ai-managed" not in app.domains[value].tags:
                return emit(opaque)
            value = app.domains[value]

    try:
        setattr(vm, prop, value)
    except AttributeError:
        return emit({"ok": False, "error": f"property '{prop}' does not exist"})
    except Exception as e:
        return emit({"ok": False, "error": f"set failed: {e}"})

    return emit({"ok": True})


if __name__ == "__main__":
    sys.exit(main())
