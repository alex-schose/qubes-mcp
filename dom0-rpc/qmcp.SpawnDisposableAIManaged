#!/usr/bin/env python3
"""qmcp.SpawnDisposableAIManaged — create an ephemeral DispVM from an
ai-managed DVMT, force-tag it, and return the auto-assigned name.

Stage E2. Complements Stage D's klass=DispVM support in
qmcp.SpawnAIManagedQube: that ships persistent named disposables;
this ships the "spin up, run, auto-destroy on shutdown" pattern via
`admin.vm.CreateDisposable`. The created qube has auto_cleanup=True
by the Admin API default, so dom0 removes it when it halts.

Input  (stdin, JSON): {
    "template": "<ai-managed DVMT — must have template_for_dispvms=True>"
}

Output (stdout, JSON):
    {"ok": true,  "name": "<auto-assigned name, e.g. disp1234>"}
    {"ok": false, "error": "not found"}     -- template missing or not ai-managed
    {"ok": false, "error": "<reason>"}      -- includes the template_for_dispvms
                                               cross-ref message when applicable

The template's existence-or-tag is hidden behind the literal "not found"
to match qmcp.GetPropertyAIManaged's existence-oracle stance — AI
cannot use this surface to probe whether a named qube exists untagged.

Atomicity: the new disposable is created by qubesd, then this script
applies the ai-managed tag via a direct admin call. Between those two
steps the qube exists untagged. If tag application fails, the script
rolls back by killing the qube (auto_cleanup then removes it). A
post-condition check confirms the tag is visible before declaring
success. The race window is visible to concurrent dom0 admin tools
but not observable by AI via the qrexec policy surface.

All admin operations on the new disposable use `app.qubesd_call(name,
...)` directly rather than going through `app.domains[name]`. The
qubesadmin `VMCollection` populates lazily and does NOT refresh
synchronously after a CreateDisposable, so `app.domains[disp_name]`
transiently raises KeyError immediately after creation. Routing
through qubesd_call sidesteps that cache entirely. (Note: this path
also bypasses the `admin.vm.tag.Set` qrexec policy deny — that deny
only applies to inter-qube calls; we are running inside dom0 talking
to qubesd over the local socket, with full admin authority.)
"""
from __future__ import annotations

import json
import sys

NOT_FOUND = {"ok": False, "error": "not found"}


def _load_budget_lib():
    """Load the sibling qmcp_budget helper by path.

    Stage I-0. The helper lives next to this wrapper in /etc/qubes-rpc/
    (production) and in public/dom0-rpc/ (offline-validation). Loading
    via importlib avoids any sys.path or PYTHONPATH dependency.
    """
    import importlib.util
    import os.path
    here = os.path.dirname(os.path.realpath(__file__))
    spec = importlib.util.spec_from_file_location(
        "qmcp_budget", os.path.join(here, "qmcp_budget.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_AUDIT_SERVICE = "qmcp.SpawnDisposableAIManaged"
#: Request-derived, whitelisted call summary (qube names / keys / actions
#: only — never a property/feature *value*). main() fills it in; emit()
#: hands it to the audit trail. Built by whitelist so a value field can
#: never leak into the log by omission.
_audit_summary: dict = {}


def _load_audit_lib():
    """Load the sibling qmcp_audit helper by path (Stage I-2).

    Same sibling-import shim as qmcp_budget / qmcp_scope. Returns None on
    any failure — auditing is strictly best-effort and must never block
    or break the wrapped operation (STAGE-I-BUILD-PLAN.md §4 I-2).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_audit", os.path.join(here, "qmcp_audit.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_AUDIT = _load_audit_lib()


def _load_tier_lib():
    """Load the sibling qmcp_tier helper by path (Stage I-5).

    Same sibling-import shim as qmcp_audit / qmcp_budget. Returns None on
    any failure; the tier gate then FAILS CLOSED (denies). Unlike the
    best-effort audit hook, a missing tier resolver must NEVER grant
    authority (STAGE-I-BUILD-PLAN.md §I-5).
    """
    try:
        import importlib.util
        import os.path
        here = os.path.dirname(os.path.realpath(__file__))
        spec = importlib.util.spec_from_file_location(
            "qmcp_tier", os.path.join(here, "qmcp_tier.py")
        )
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


_TIER = _load_tier_lib()


def _require_full(vm) -> bool:
    """Stage I-5: True iff `vm` grants CAP_FULL via the tier resolver.

    FAIL-CLOSED: a missing/broken resolver (_TIER is None) or any tag-read
    error denies. Behaviour-neutral in compat (untiered ai-managed = ai-full,
    the I-3..I-5 default); becomes the live gate once the operator writes
    "ro" to /etc/qmcp/tier-default. The call-site refusal collapses to the
    same opaque message as an untagged target, so it is no tier oracle.
    """
    if _TIER is None:
        return False
    try:
        return _TIER.has_capability(vm, _TIER.CAP_FULL)
    except Exception:
        return False


def emit(payload: dict) -> int:
    # Stage I-2: record this state-changing call on the hash-chained dom0
    # audit trail before responding. Best-effort and defensively guarded
    # so an audit failure can never change what AI sees or whether the
    # operation ran (qmcp_audit.audit is itself non-raising; the guard is
    # belt-and-suspenders at the security boundary).
    if _AUDIT is not None:
        try:
            _AUDIT.audit(_AUDIT_SERVICE, _audit_summary,
                         bool(payload.get("ok")), payload.get("error"))
        except Exception:
            pass
    print(json.dumps(payload))
    return 0 if payload.get("ok") else 1


def create_disposable(app, tpl) -> str:
    """Invoke admin.vm.CreateDisposable for `tpl`; return the assigned name.

    Routes through the qubesd-call surface directly rather than via any
    high-level qubesadmin helper, because the helper's name has drifted
    between qubesadmin versions (create_disposable_vm vs. create_dispvm
    vs. a method on the template VM). The qubesd_call shape is the
    stable Admin API contract."""
    raw = app.qubesd_call(tpl.name, "admin.vm.CreateDisposable")
    name = raw.decode(errors="replace").strip()
    if not name:
        raise RuntimeError("CreateDisposable returned empty name")
    return name


def apply_tag_direct(app, vm_name: str, tag: str) -> None:
    """Set a tag via direct admin call — bypasses the domains cache."""
    app.qubesd_call(vm_name, "admin.vm.tag.Set", tag)


def has_tag_direct(app, vm_name: str, tag: str) -> bool:
    """Read tags via direct admin call. Returns True iff `tag` is set."""
    raw = app.qubesd_call(vm_name, "admin.vm.tag.List")
    tags = set(raw.decode(errors="replace").split())
    return tag in tags


def list_tags_direct(app, vm_name: str) -> set:
    """All tags on `vm_name` via direct admin call (cache-lag-safe)."""
    raw = app.qubesd_call(vm_name, "admin.vm.tag.List")
    return set(raw.decode(errors="replace").split())


def remove_tag_direct(app, vm_name: str, tag: str) -> None:
    """Remove a tag via direct admin call — bypasses the domains cache."""
    app.qubesd_call(vm_name, "admin.vm.tag.Remove", tag)


def _tier_tags_to_strip() -> set:
    """The qmcp tier tags a freshly-created qube must NOT carry — every tag in
    the tier vocabulary except the umbrella. _TIER is guaranteed loaded here
    (we passed _require_full, which denies when _TIER is None)."""
    return set(_TIER.QMCP_TIER_TAGS) - {_TIER.UMBRELLA}


def strip_inherited_tier_tags_direct(app, vm_name: str) -> None:
    """Stage I-5 keystone enforcement. admin.vm.CreateDisposable INHERITS the
    DVMT's tags (slot-16 confirmed `ai-managed` is inherited), so a disposable
    from an `ai-full` DVMT also inherits `ai-full` — an ephemeral CAP_FULL grant
    the gate is meant to withhold. Remove every elevation/orthogonal tier tag so
    the disposable is UNTIERED. Uses direct qubesd calls for the same
    VMCollection-cache-lag reason the rest of this wrapper does. Raises if any
    tier tag survives, so the caller rolls the disposable back."""
    # Read-first: only remove tags actually present, so this is robust whether
    # admin.vm.tag.Remove is idempotent or errors on an absent tag.
    present = list_tags_direct(app, vm_name)
    for tag in (_tier_tags_to_strip() & present):
        remove_tag_direct(app, vm_name, tag)
    leftover = _tier_tags_to_strip() & list_tags_direct(app, vm_name)
    if leftover:
        raise RuntimeError(f"failed to strip inherited tier tags: {sorted(leftover)}")


def kill_direct(app, vm_name: str) -> None:
    """Kill a VM via direct admin call. auto_cleanup=True disposables
    are removed by qubesd once halted, so kill alone suffices."""
    app.qubesd_call(vm_name, "admin.vm.Kill")


def main() -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as e:
        return emit({"ok": False, "error": f"invalid JSON input: {e}"})

    template = req.get("template", "")
    _audit_summary.update({"template": template})
    if not template:
        return emit(NOT_FOUND)

    try:
        import qubesadmin.app
        app = qubesadmin.app.QubesLocal()
    except Exception as e:
        return emit({"ok": False, "error": f"qubesadmin import failed: {e}"})

    # Template visibility check — collapse missing/untagged to opaque "not found"
    # so the disposable-spawn surface cannot be used as an existence oracle.
    if template not in app.domains:
        return emit(NOT_FOUND)
    tpl = app.domains[template]
    if "ai-managed" not in tpl.tags:
        return emit(NOT_FOUND)

    # Stage I-5: the DVMT must grant CAP_FULL to be a disposable source.
    # Fail-closed; collapses to the same opaque NOT_FOUND as an untagged
    # template (no tier oracle), before the template_for_dispvms cross-ref.
    if not _require_full(tpl):
        return emit(NOT_FOUND)

    # Cross-ref: a DVMT must have template_for_dispvms=True. This is NOT
    # hidden behind "not found" — the template is ai-managed (AI can see
    # it via ListAIManagedQubes), so a more informative error is fine and
    # matches the Stage D klass=DispVM cross-ref behaviour in
    # SpawnAIManagedQube.
    try:
        is_dvmt = bool(getattr(tpl, "template_for_dispvms", False))
    except Exception:
        is_dvmt = False
    if not is_dvmt:
        return emit({"ok": False, "error":
            f"template '{template}' must have template_for_dispvms=True "
            f"to be a DispVM source (klass is {tpl.klass})"})

    # ----- I-0 budget gate (persistent-footprint basis, 2026-06-12) -----
    # Refuse if the projected persistent sum would exceed `/etc/qmcp/pool-cap`.
    # A disposable's root is COW from the DVMT and its volatile is ephemeral, so
    # the only persistent bytes it adds (while it exists) are its private — the
    # spawn estimate (the Qubes default; disposables take no private_size param).
    # The default gate call (no is_clone, no requested_private) selects exactly
    # that. Measurement mirrors qmcp.GetPoolStats (shared summer); cap-missing
    # fails closed with the same opaque message.
    try:
        budget = _load_budget_lib()
    except Exception as e:
        return emit({"ok": False, "error": f"budget helper load failed: {e}"})
    cap_err = budget.check_cap_for_create(app, tpl)
    if cap_err is not None:
        return emit({"ok": False, "error": cap_err})

    # ----- Step 1: create the disposable -----
    try:
        disp_name = create_disposable(app, tpl)
    except Exception as e:
        return emit({"ok": False, "error": f"CreateDisposable failed: {e}"})

    # ----- Step 2: apply ai-managed tag (race window starts here) -----
    # Direct admin calls — see module docstring for why we bypass
    # `app.domains[disp_name]` here (the VMCollection cache lags
    # CreateDisposable and raises KeyError for several seconds).
    try:
        apply_tag_direct(app, disp_name, "ai-managed")
        if not has_tag_direct(app, disp_name, "ai-managed"):
            raise RuntimeError("tag.Set returned but tag not visible on refresh")
        # Stage I-5: CreateDisposable inherited the DVMT's tags, so the
        # disposable may carry an inherited ai-full/ai-net/ai-exec/ai-dump.
        # Strip them — a created qube is UNTIERED (umbrella only). (See helper.)
        strip_inherited_tier_tags_direct(app, disp_name)
    except Exception as tag_err:
        try:
            kill_direct(app, disp_name)
            return emit({"ok": False,
                         "error": f"tag application failed (rolled back): {tag_err}"})
        except Exception as kill_err:
            return emit({"ok": False, "error":
                f"tag application failed AND kill failed: "
                f"tag-err={tag_err}, kill-err={kill_err}; "
                f"manual cleanup of qube '{disp_name}' required in dom0"})

    return emit({"ok": True, "name": disp_name})


if __name__ == "__main__":
    sys.exit(main())
