admin.property.Reset                          *  @tag:ai-managed  @anyvm  deny
admin.property.Set                            *  @tag:ai-managed  @anyvm  deny
admin.vmclass.List                            *  @tag:ai-managed  @anyvm  deny
admin.vm.Console                              *  @tag:ai-managed  @anyvm  deny
admin.vm.Create.AdminVM                       *  @tag:ai-managed  @anyvm  deny
admin.vm.Create.AppVM                         *  @tag:ai-managed  @anyvm  deny
admin.vm.CreateDisposable                     *  @tag:ai-managed  @anyvm  deny
admin.vm.Create.DispVM                        *  @tag:ai-managed  @anyvm  deny
admin.vm.CreateInPool.AdminVM                 *  @tag:ai-managed  @anyvm  deny
admin.vm.CreateInPool.AppVM                   *  @tag:ai-managed  @anyvm  deny
admin.vm.CreateInPool.DispVM                  *  @tag:ai-managed  @anyvm  deny
